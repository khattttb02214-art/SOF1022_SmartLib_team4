@model IEnumerable<Assignment.Models.Entities.KeSach>
@{
    ViewData["Title"] = "Quản lý Kệ sách";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary">QUẢN LÝ KỆ SÁCH</h3>
        <a asp-action="Create" class="btn btn-primary px-4 py-2">Thêm Kệ Mới</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-controller="KeSach" asp-action="Index" method="get" class="row g-3">
                <div class="col-md-9"><input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Tìm theo tên kệ..."></div>
                <div class="col-md-3 d-flex gap-2"><button type="submit" class="btn btn-primary w-100">Tìm kiếm</button><a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a></div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Tên Kệ</th>
                    <th>Vị Trí</th>
                    <th>Danh sách mã sách</th>
                    <th>Số lượng</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@item.TenKe</td>
                        <td>@item.ViTri</td>
                        <td class="text-muted small">@string.Join(", ", item.Saches.Select(s => s.MaSach))</td>
                        <td>@item.Saches.Count() cuốn</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-make="@item.MaKe" class="btn btn-warning">Sửa</a>
                                <a asp-action="Details" asp-route-make="@item.MaKe" class="btn btn-info text-white">Chi tiết</a>
                                <a asp-action="Delete" asp-route-make="@item.MaKe" class="btn btn-danger">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>