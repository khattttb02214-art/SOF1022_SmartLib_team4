@model Assignment.Models.Entities.KeSach

@{
    ViewData["Title"] = "Thêm kệ mới";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 600px; margin: 0 auto; overflow: hidden;">
        <div class="card-header bg-primary py-3 border-0">
            <h4 class="mb-0 fw-bold text-white text-center">
                <i class="bi bi-plus-circle"></i> THÊM KỆ SÁCH MỚI
            </h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenKe" class="form-label fw-bold">Tên Kệ</label>
                    <input asp-for="TenKe" class="form-control form-control-lg" placeholder="Nhập tên kệ..." />
                    <span asp-validation-for="TenKe" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ViTri" class="form-label fw-bold">Vị Trí</label>
                    <input asp-for="ViTri" class="form-control form-control-lg" placeholder="Nhập vị trí..." />
                    <span asp-validation-for="ViTri" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Saches" class="form-label fw-bold">Danh sách Sách</label>
                    <input asp-for="Saches" class="form-control form-control-lg" placeholder="Nhập danh sách..." />
                    <span asp-validation-for="Saches" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary w-50 py-2 fw-bold">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary w-50 py-2 fw-bold shadow-sm">
                        <i class="bi bi-floppy"></i> Lưu Kệ Mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}