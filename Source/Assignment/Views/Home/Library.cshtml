@model IEnumerable<Assignment.Models.Entities.Sach>
@{
    ViewData["Title"] = "Thư viện SmartLib";
}

<style>
    .book-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

        .book-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
        }

    .book-img-wrapper {
        height: 320px;
        overflow: hidden;
    }

    .book-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-body {
        padding: 1.25rem;
    }

    .badge-stock {
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5 text-primary">KHO TÀNG TRI THỨC</h2>
        <div class="divider mx-auto bg-primary" style="width: 80px; height: 4px; border-radius: 2px;"></div>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card h-100 book-card shadow-sm">
                    <div class="book-img-wrapper">
                        <img src="~/images/@(string.IsNullOrEmpty(item.AnhBia) ? "default-book.jpg" : item.AnhBia)"
                             class="card-img-top book-img" alt="@item.TenSach">
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-truncate" title="@item.TenSach">@item.TenSach</h5>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-person-fill"></i> Tác giả: @(item.MaTacGia != null ? string.Join(", ", item.MaTacGia.Select(t => t.TenTacGia)) : "Chưa cập nhật")
                        </p>

                        <div class="mt-auto">
                            <div class="mb-3">
                                <span class="badge badge-stock @(item.SoLuongKhaDung > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    <i class="bi bi-book"></i> @(item.SoLuongKhaDung > 0 ? "Còn " + item.SoLuongKhaDung + " cuốn" : "Hết sách")
                                </span>
                            </div>

                            @if (item.SoLuongKhaDung > 0)
                            {
                                <a asp-controller="Home" asp-action="DangKyMuon"
                                   asp-route-maSach="@item.MaSach"
                                   class="btn btn-primary w-100 fw-semibold shadow-sm">Mượn ngay</a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>Tạm hết</button>
                            }

                            @if (User.IsInRole("DocGia"))
                            {
                                <form asp-controller="Wishlist" asp-action="ThemVaoWishlist" method="post">
                                    <input type="hidden" name="maSach" value="@item.MaSach" />
                                    <button type="submit" class="btn btn-outline-danger w-100 mt-2">
                                        <i class="bi bi-heart"></i> Yêu thích
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>