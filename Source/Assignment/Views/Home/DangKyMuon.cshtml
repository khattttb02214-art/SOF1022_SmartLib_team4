@model Assignment.Models.Entities.Sach
@{
    ViewData["Title"] = "Đăng ký mượn sách";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 550px; margin: 0 auto; overflow: hidden;">
        <div class="card-header bg-primary text-white text-center py-3 border-0">
            <h4 class="mb-0 fw-bold"><i class="bi bi-clipboard-check"></i> ĐĂNG KÝ MƯỢN SÁCH</h4>
        </div>

        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h5 class="fw-bold text-primary mb-1">@Model.TenSach</h5>
                <p class="text-muted small mb-0">
                    <i class="bi bi-person-fill"></i> Tác giả: @(Model.MaTacGia != null ? string.Join(", ", Model.MaTacGia.Select(t => t.TenTacGia)) : "Chưa cập nhật")
                </p>
            </div>

            <hr class="my-3">

            <form asp-action="DangKyMuon" method="post">
                <input type="hidden" name="maSach" value="@Model.MaSach" />

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Chọn ngày hẹn trả</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                        <input type="date" name="ngayHenTra" class="form-control form-control-lg"
                               min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")"
                               max="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")"
                               required />
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="bi bi-info-circle"></i> Vui lòng chọn ngày trả trong vòng 30 ngày.
                    </small>
                </div>

                <div class="d-flex gap-3">
                    <a asp-action="Library" class="btn btn-outline-secondary w-50 py-2 fw-bold">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary w-50 py-2 fw-bold shadow-sm">
                        Gửi yêu cầu <i class="bi bi-send"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>