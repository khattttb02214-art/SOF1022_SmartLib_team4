@model IEnumerable<Assignment.Models.Entities.Sach>

<div class="container mt-5">
    <!-- Hero Section -->
    <div class="p-5 mb-4 bg-primary text-white rounded-3 shadow">
        <h1 class="display-4">Chào mừng đến với SmartLib!</h1>
        <p>Hệ thống quản lý thư viện thông minh, giúp bạn tìm kiếm và mượn sách dễ dàng.</p>
        <a asp-action="Library" class="btn btn-light btn-lg">Khám phá thư viện ngay</a>
    </div>

    <!-- Sách mới nhất -->
    <h3 class="mb-4">Sách mới cập nhật</h3>
	
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3">
                <div class="card mb-4">
                    <img src="~/images/@(item.AnhBia ?? "default-book.jpg")" class="card-img-top" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h6 class="card-title fw-bold">@item.TenSach</h6>
                    </div>
                </div>
            </div>
        }
    </div>
</div>