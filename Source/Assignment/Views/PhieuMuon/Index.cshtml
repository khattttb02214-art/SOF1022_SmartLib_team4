@model IEnumerable<Assignment.Models.Entities.MuonTra>

<h2>Danh Sách Phiếu Mượn</h2>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Tìm theo mã phiếu hoặc tên độc giả..." value="@ViewBag.CurrentFilter" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-secondary">Xóa bộ lọc</a>
    </div>
</form>

<a asp-action="Create" class="btn btn-success mb-3">+ Lập phiếu mượn mới</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã Phiếu</th>
            <th>Độc Giả</th>
            <th>Sách Mượn</th>
            <th>Ngày Mượn</th>
            <th>Ngày Hẹn Trả</th>
            <th>Trạng Thái</th>
            <th>Hành Động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaPhieu</td>
                <td>@item.MaDocGiaNavigation?.HoTen</td>
                <td>
                    @if (item.ChiTietMuonTras != null)
                    {
                        @foreach (var ct in item.ChiTietMuonTras)
                        {
                            // Truy cập qua MaCuonSachNavigation (là bản thân cuốn sách)
                            // Rồi qua MaSachNavigation (là thông tin sách tổng quát)
                            // Rồi mới đến TenSach
                            <span class="badge bg-info text-dark">
                                @ct.MaCuonSachNavigation?.MaSachNavigation?.TenSach
                            </span><br />
                        }
                    }
                </td>
                <td>@item.NgayMuon</td>
                <td>@item.NgayHenTra</td>
                <td>@item.TrangThai</td>
                <td>
                    @if (item.TrangThai == "Chờ xác nhận")
                    {
                        <a asp-action="XacNhan" asp-route-id="@item.MaPhieu"
                           class="btn btn-sm btn-success">Xác nhận</a>
                    }
                    @if (item.TrangThai == "Chưa Trả")
                    {
                        <form asp-action="TraSach" asp-route-id="@item.MaPhieu" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-info">Trả sách</button>
                        </form>
                    }

                    <a asp-action="Edit" asp-route-id="@item.MaPhieu" class="btn btn-sm btn-warning">Sửa</a>

                    <form asp-action="Delete" asp-route-id="@item.MaPhieu" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa phiếu này?');">
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>