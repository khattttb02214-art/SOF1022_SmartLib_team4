<form asp-action="NhapKho" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" name="MaSach" value="@ViewBag.MaSach" />

    <div class="mb-3">
        <label>Mã vạch (Barcode):</label>
        <input name="Barcode" id="barcodeInput" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Trạng thái:</label>
        <select name="TrangThai" class="form-control">
            <option value="Có sẵn">Có sẵn</option>
            <option value="Hư hỏng">Hư hỏng</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Xác nhận nhập kho</button>
</form>

@section Scripts {
    <script>
        // Tự động sinh barcode khi load trang
        fetch('/Kho/GetNextBarcode?maSach=@ViewBag.MaSach')
            .then(r => r.json())
            .then(data => {
                document.getElementById('barcodeInput').value = data.barcode;
            });
    </script>
}