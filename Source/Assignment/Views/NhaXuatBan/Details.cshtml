@model Assignment.Models.Entities.NhaXuatBan

@{
    ViewData["Title"] = "Chi tiết NXB";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 700px; margin: 0 auto; overflow: hidden;">
        <div class="card-header bg-primary py-4 border-0 text-center">
            <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                <i class="bi bi-building"></i>
            </div>
            <h4 class="mb-0 fw-bold text-white">@Model.TenNxb</h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-start p-3">
                    <div>
                        <div class="fw-bold text-muted small"><i class="bi bi-geo-alt"></i> ĐỊA CHỈ</div>
                        <div class="fs-6 mt-1">@Model.DiaChi</div>
                    </div>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-start p-3">
                    <div>
                        <div class="fw-bold text-muted small"><i class="bi bi-telephone"></i> SỐ ĐIỆN THOẠI</div>
                        <div class="fs-6 mt-1">@Model.SoDienThoai</div>
                    </div>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-start p-3">
                    <div>
                        <div class="fw-bold text-muted small"><i class="bi bi-envelope"></i> EMAIL</div>
                        <div class="fs-6 mt-1">@Model.Email</div>
                    </div>
                </li>
            </ul>

            <div class="d-flex gap-3 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary w-50 py-2 fw-bold">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.MaNxb" class="btn btn-warning w-50 py-2 fw-bold shadow-sm">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>