@model Assignment.Models.Entities.NhaXuatBan

@{
    ViewData["Title"] = "Chỉnh sửa NXB";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 600px; margin: 0 auto; overflow: hidden;">
        <div class="card-header bg-warning py-3 border-0">
            <h4 class="mb-0 fw-bold text-dark text-center">
                <i class="bi bi-pencil-square"></i> CHỈNH SỬA NHÀ XUẤT BẢN
            </h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaNxb" />

                <div class="mb-3">
                    <label asp-for="TenNxb" class="form-label fw-bold">Tên NXB</label>
                    <input asp-for="TenNxb" class="form-control form-control-lg" />
                    <span asp-validation-for="TenNxb" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ</label>
                    <input asp-for="DiaChi" class="form-control form-control-lg" />
                    <span asp-validation-for="DiaChi" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SoDienThoai" class="form-label fw-bold">Số điện thoại</label>
                    <input asp-for="SoDienThoai" class="form-control form-control-lg" />
                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary w-50 py-2 fw-bold">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning w-50 py-2 fw-bold shadow-sm text-dark">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}