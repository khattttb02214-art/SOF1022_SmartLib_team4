@model IEnumerable<Assignment.Models.Entities.NhaXuatBan>

@{
    ViewData["Title"] = "Quản lý NXB";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary"><i class="bi bi-buildings"></i> QUẢN LÝ NHÀ XUẤT BẢN</h3>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3 fw-bold">
            <i class="bi bi-plus-lg"></i> Thêm NXB Mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-controller="NhaXuatBan" asp-action="Index" method="get" class="row g-3">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentFilter"
                               class="form-control border-0 bg-light" placeholder="Nhập tên nhà xuất bản cần tìm...">
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 fw-bold">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-3">Reset</a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["ErrorMessage"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tên NXB</th>
                        <th>Địa chỉ</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">@item.TenNxb</td>
                            <td>@item.DiaChi</td>
                            <td><i class="bi bi-telephone text-muted"></i> @item.SoDienThoai</td>
                            <td><i class="bi bi-envelope text-muted"></i> @item.Email</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <!-- Thay vì chỉ dùng icon, mình thêm chữ vào cho chắc chắn -->
                                    <a asp-action="Edit" asp-route-id="@item.MaNxb" class="btn btn-warning text-dark fw-bold" title="Sửa">
                                        <i class="bi bi-pencil-fill"></i> Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.MaNxb" class="btn btn-info text-white fw-bold" title="Chi tiết">
                                        <i class="bi bi-info-circle-fill"></i> Xem
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaNxb" class="btn btn-danger text-white fw-bold" title="Xóa">
                                        <i class="bi bi-trash-fill"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>