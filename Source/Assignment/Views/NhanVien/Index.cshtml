@model IEnumerable<Assignment.Models.Entities.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<h1>Danh sách nhân viên</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Thêm nhân viên mới</a>
</p>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" value="@ViewBag.CurrentFilter"
               class="form-control" placeholder="Tìm theo tên hoặc email...">
        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Làm mới</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Họ Tên</th>
            <th>Email</th>
            <th>Số ĐT</th>
            <th>Chức vụ</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.HoTen)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.SoDienThoai)</td>
                <td>
                    @if (item.MaChucVuNavigation != null)
                    {
                        @item.MaChucVuNavigation.TenChucVu
                    }
                    else
                    {
                        <span class="text-muted">Chưa phân quyền</span>
                    }
                </td>
                <td>
                    @if (item.TrangThai == true)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Khóa</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-manv="@item.MaNv" class="btn btn-sm btn-warning">Edit</a> |
                    <a asp-action="Details" asp-route-manv="@item.MaNv" class="btn btn-sm btn-info">Details</a> |
                    <a asp-action="Delete" asp-route-manv="@item.MaNv" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>