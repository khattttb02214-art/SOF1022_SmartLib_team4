@model Assignment.Models.Entities.NhanVien

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<h1>Thêm nhân viên</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="MaNv" class="control-label"></label>
                <input asp-for="MaNv" class="form-control" />
                <span asp-validation-for="MaNv" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HoTen" class="control-label"></label>
                <input asp-for="HoTen" class="form-control" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="MatKhau" class="control-label"></label>
                <input asp-for="MatKhau" type="password" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="MaChucVu" class="control-label">Chức vụ</label>
                <select asp-for="MaChucVu" class="form-control" asp-items="ViewBag.MaChucVu">
                    <option value="">-- Chọn chức vụ --</option>
                </select>
                <span asp-validation-for="MaChucVu" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrangThai" class="control-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-control" asp-items="ViewBag.TrangThaiList">
                    <option value="true">Đang hoạt động</option>
                    <option value="false">Khóa</option>
                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}