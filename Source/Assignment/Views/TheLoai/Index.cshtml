@model IEnumerable<Assignment.Models.Entities.TheLoai>

@{
    ViewData["Title"] = "Quản lý Thể loại - SmartLib";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">DANH SÁCH THỂ LOẠI SÁCH</h2>
        <a asp-action="Create" class="btn btn-success fw-bold">+ Thêm Thể Loại Mới</a>
    </div>

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Tìm theo Mã hoặc Tên thể loại..." />
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-secondary">Làm mới</a>
        </div>
    </form>
</div>



    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%;">Mã Thể Loại</th>
                        <th style="width: 30%;">Tên Thể Loại</th>
                        <th>Mô Tả Chi Tiết</th>
                        <th style="width: 15%;" class="text-center">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">@item.MaTheLoai</td>
                                <td class="text-dark fw-bold">@item.TenTheLoai</td>
                                <td>@item.MoTa</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-warning btn-sm">Sửa</a>
                                        <a class="btn btn-danger btn-sm">Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Chưa có dữ liệu thể loại nào dưới Database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>