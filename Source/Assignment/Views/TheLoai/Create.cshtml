@model Assignment.Models.Entities.TheLoai

@{
    ViewData["Title"] = "Thêm mới Thể loại - SmartLib";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0 fw-bold">THÊM THỂ LOẠI SÁCH MỚI</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MaTheLoai" class="form-label fw-bold">Mã Thể Loại</label>
                    <input asp-for="MaTheLoai" class="form-control" placeholder="Ví dụ: TL01, IT, CNTT..." required />
                    <span asp-validation-for="MaTheLoai" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TenTheLoai" class="form-label fw-bold">Tên Thể Loại</label>
                    <input asp-for="TenTheLoai" class="form-control" placeholder="Ví dụ: Công nghệ thông tin, Tiểu thuyết..." required />
                    <span asp-validation-for="TenTheLoai" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">Mô Tả</label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả ngắn về thể loại này..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary fw-bold">Quay Lại Danh Sách</a>
                    <button type="submit" class="btn btn-success fw-bold px-4">Lưu Lại</button>
                </div>
            </form>
        </div>
    </div>
</div>