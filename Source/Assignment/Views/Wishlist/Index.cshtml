@model IEnumerable<Assignment.Models.Entities.Wishlist>
@{
    ViewData["Title"] = "Wishlist của tôi";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary display-6">
            <i class="bi bi-heart-fill text-danger"></i>
            @(User.IsInRole("DocGia") ? "SÁCH YÊU THÍCH CỦA TÔI" : "WISHLIST KHÁCH HÀNG")
        </h2>
        <div class="divider mx-auto bg-danger" style="width: 80px; height: 4px; border-radius: 2px;"></div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-emoji-frown display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Danh sách yêu thích đang trống!</h4>
            <a asp-controller="Home" asp-action="Library" class="btn btn-primary mt-3">Khám phá thư viện</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden book-card">
                        <div style="height: 250px; overflow: hidden;">
                            <img src="~/images/@(string.IsNullOrEmpty(item.MaSachNavigation.AnhBia) ? "default-book.jpg" : item.MaSachNavigation.AnhBia)"
                                 class="card-img-top h-100 w-100" style="object-fit: cover;" alt="@item.MaSachNavigation.TenSach" />
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="fw-bold text-truncate" title="@item.MaSachNavigation.TenSach">@item.MaSachNavigation.TenSach</h5>
                            <p class="text-muted small mb-1">
                                <i class="bi bi-person"></i> @string.Join(", ", item.MaSachNavigation.MaTacGia.Select(t => t.TenTacGia))
                            </p>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-calendar-plus"></i> Đã thêm: @item.NgayThem?.ToString("dd/MM/yyyy")
                            </p>

                            @if (User.IsInRole("ADMIN") || User.IsInRole("ThuThu"))
                            {
                                <div class="bg-light p-2 rounded mb-3 small">
                                    <i class="bi bi-person-badge"></i> Độc giả: <b>@item.MaDocGiaNavigation.HoTen</b>
                                </div>
                            }

                            <div class="mt-auto">
                                @if (User.IsInRole("DocGia"))
                                {
                                    <form asp-action="Xoa" method="post">
                                        <input type="hidden" name="maSach" value="@item.MaSach" />
                                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold">
                                            <i class="bi bi-trash"></i> Xóa khỏi danh sách
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>