@model Assignment.Models.Entities.Sach

@{
    ViewData["Title"] = "Thêm sách mới - SmartLib";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 900px; margin: 0 auto; overflow: hidden;">
        <div class="card-header bg-primary py-3 border-0">
            <h4 class="mb-0 fw-bold text-white text-center">
                <i class="bi bi-plus-circle"></i> THÊM SÁCH MỚI
            </h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden" name="SoLuongKho" value="0" />
                <input type="hidden" name="SoLuongKhaDung" value="0" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="MaSach" class="form-label fw-bold">Mã Sách</label>
                            <input asp-for="MaSach" class="form-control" required placeholder="Nhập mã (ví dụ: S001)" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="TenSach" class="form-label fw-bold">Tên Sách</label>
                            <input asp-for="TenSach" class="form-control" required placeholder="Nhập tên sách" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh bìa</label>
                            <input type="file" name="fileAnh" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="MaTheLoai" class="form-label fw-bold">Thể Loại</label>
                            <select asp-for="MaTheLoai" asp-items="ViewBag.MaTheLoai" class="form-select"></select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="MaNxb" class="form-label fw-bold">Nhà Xuất Bản</label>
                            <select asp-for="MaNxb" asp-items="ViewBag.MaNxb" class="form-select"></select>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Danh sách Tác Giả (Nhấn Ctrl để chọn nhiều)</label>
                    <select name="selectedTacGiaIds" class="form-select" multiple style="height: 120px;">
                        @foreach (var tg in (List<Assignment.Models.Entities.TacGium>)ViewBag.TacGiaList)
                        {
                            <option value="@tg.MaTacGia">@tg.TenTacGia</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-3 justify-content-end pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Quay Lại</a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                        <i class="bi bi-floppy"></i> Lưu Sách
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>