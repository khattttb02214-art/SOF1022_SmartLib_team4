@model IEnumerable<Assignment.Models.Entities.Sach>

@{
    ViewData["Title"] = "Quản lý Sách - SmartLib";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">QUẢN LÝ DANH SÁCH SÁCH</h2>
        <a asp-action="Create" class="btn btn-success fw-bold">+ Thêm Sách Mới</a>
    </div>

    <div class="card mb-4 bg-light shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-9">
                    <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Nhập tên sách hoặc tên tác giả cần tìm..." />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-secondary w-100">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Sách</th>
                        <th>Tên Cuốn Sách</th>
                        <th>Thể Loại</th>
                        <th>Nhà Xuất Bản</th>
                        <th>Tác Giả</th>
                        <th>Vị Trí Kệ</th>
                        <th>Số Lượng</th>
                        <th class="text-center">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">@item.MaSach</td>
                                <td class="text-dark fw-bold">@item.TenSach</td>
                                <td>@(item.MaTheLoaiNavigation != null ? item.MaTheLoaiNavigation.TenTheLoai : item.MaTheLoai)</td>
                                <td>@(item.MaNxbNavigation != null ? item.MaNxbNavigation.TenNxb : item.MaNxb)</td>
                                <td>
                                    @if (item.MaTacGia != null)
                                    {
                                        @string.Join(", ", item.MaTacGia.Select(t => t.TenTacGia))
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có tác giả</span>
                                    }
                                </td>
                                <td>@(item.MaKeNavigation != null ? item.MaKeNavigation.TenKe : item.MaKe)</td>
                                <td class="text-center fw-bold text-info">@item.SoLuongKhaDung</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.MaSach">Sửa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Không tìm thấy cuốn sách nào phù hợp trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>