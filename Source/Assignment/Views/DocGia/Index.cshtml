@model IEnumerable<Assignment.Models.Entities.DocGium>

<div class="container mt-4">
    <h2>Danh sách Độc Giả</h2>

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Tìm theo Mã hoặc Tên..." />
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Làm mới</a>
        </div>
    </form>

    <p><a asp-action="Create" class="btn btn-primary">Thêm Độc Giả</a></p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Mã ĐG</th>
                <th>Họ Tên</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaDocGia</td>
                    <td>@item.HoTen</td>
                    <td>@(item.TrangThaiThe.GetValueOrDefault() ? "Hoạt động" : "Bị khóa")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaDocGia" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.MaDocGia" class="btn btn-sm btn-info">Chi tiết</a>

                        @if (item.TrangThaiThe.GetValueOrDefault())
                        {
                            <form asp-action="Delete" asp-route-id="@item.MaDocGia" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger">Khóa thẻ</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="MoKhoa" asp-route-id="@item.MaDocGia" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-success">Mở thẻ</button>
                            </form>
                        }
                        <a asp-action="GiaHan" asp-route-id="@item.MaDocGia" class="btn btn-sm btn-primary">Gia hạn</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>