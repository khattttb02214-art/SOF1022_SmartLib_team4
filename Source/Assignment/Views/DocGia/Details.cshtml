@model Assignment.Models.Entities.DocGium

@{
    ViewData["Title"] = "Chi tiết Độc giả";
}

<div class="container mt-4">
    <h2>Chi tiết Độc giả</h2>
    <hr />

    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@Model.HoTen</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">Mã Độc Giả</dt>
                <dd class="col-sm-9">@Model.MaDocGia</dd>

                <dt class="col-sm-3">Họ Tên</dt>
                <dd class="col-sm-9">@Model.HoTen</dd>

                <dt class="col-sm-3">Lớp</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Lop) ? "Chưa cập nhật" : Model.Lop)</dd>

                <dt class="col-sm-3">Khoa</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Khoa) ? "Chưa cập nhật" : Model.Khoa)</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Mật khẩu</dt>
                <dd class="col-sm-9">@Model.MatKhau</dd>

                <dt class="col-sm-3">Số điện thoại</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</dd>

                <dt class="col-sm-3">Địa chỉ</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</dd>

                <dt class="col-sm-3">Ngày sinh</dt>
                <dd class="col-sm-9">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>

                <dt class="col-sm-3">Ngày tạo thẻ</dt>
                <dd class="col-sm-9">@(Model.NgayTaoThe?.ToString("dd/MM/yyyy") ?? "N/A")</dd>

                <dt class="col-sm-3">Ngày hết hạn</dt>
                <dd class="col-sm-9">@(Model.NgayHetHan?.ToString("dd/MM/yyyy") ?? "N/A")</dd>

                <dt class="col-sm-3">Trạng thái thẻ</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.TrangThaiThe.GetValueOrDefault() ? "bg-success" : "bg-danger")">
                        @(Model.TrangThaiThe.GetValueOrDefault() ? "Hoạt động" : "Bị khóa")
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.MaDocGia" class="btn btn-warning">Sửa thông tin</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>