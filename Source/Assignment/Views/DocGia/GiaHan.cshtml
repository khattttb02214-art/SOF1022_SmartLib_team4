@model Assignment.Models.Entities.DocGium

<div class="container mt-4">
    <h3>Gia hạn thẻ cho: @Model.HoTen</h3>
    <form asp-action="GiaHan" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="MaDocGia" />

        <div class="mb-3">
            <label class="form-label">Chọn ngày hết hạn mới:</label>
            <input type="date" name="ngayMoi" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Xác nhận gia hạn</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>