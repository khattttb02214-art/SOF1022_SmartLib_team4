@model Assignment.Models.Entities.TacGium

@{
    ViewData["Title"] = "Thêm Tác Giả Mới";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">THÊM TÁC GIẢ MỚI</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div class="mb-3">
                    <label asp-for="MaTacGia" class="form-label fw-bold">Mã Tác Giả</label>
                    <input asp-for="MaTacGia" class="form-control" required />
                    <span asp-validation-for="MaTacGia" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TenTacGia" class="form-label fw-bold">Tên Tác Giả</label>
                    <input asp-for="TenTacGia" class="form-control" required />
                    <span asp-validation-for="TenTacGia" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TieuSu" class="form-label fw-bold">Tiểu Sử</label>
                    <textarea asp-for="TieuSu" class="form-control"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="QuocTich" class="form-label fw-bold">Quốc Tịch</label>
                    <input asp-for="QuocTich" class="form-control" />
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary fw-bold">Lưu Tác Giả</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}