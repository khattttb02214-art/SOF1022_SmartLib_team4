@model Assignment.Models.ViewModels.LoginViewModel

@{
    Layout = null; // Tắt layout chung (Header/Footer) của trang chủ để làm trang login độc lập
    ViewData["Title"] = "Đăng nhập hệ thống - SmartLib";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #f8f9fa;
            }
            .login-container {
                max-width: 400px;
                margin-top: 10%;
            }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="card shadow login-container p-4 w-100 bg-white rounded">
            <div class="text-center mb-4">
                <h3 class="text-primary fw-bold">SMARTLIB</h3>
                <p class="text-muted">Đăng nhập dành cho Nhân viên / Thủ thư</p>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label font-weight-bold">Email tài khoản</label>
                    <input asp-for="Email" class="form-control" placeholder="nhanvien@fpt.edu.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label font-weight-bold">Mật khẩu</label>
                    <input asp-for="MatKhau" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">ĐĂNG NHẬP</button>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>