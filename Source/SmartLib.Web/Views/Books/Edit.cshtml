@model SmartLib.Web.ViewModels.BookViewModel
@{
    ViewData["Title"] = "Sửa sách";
}
<div class="page-header-card">
    <h4><i class="fa fa-pen me-2"></i>Sửa sách – @Model.MaSach</h4>
</div>
<form asp-action="Edit" asp-route-id="@Model.MaSach" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="form-card">
                <h6 class="form-card-title">Thông tin cơ bản</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Mã sách</label>
                        <input asp-for="MaSach" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label req">Tên sách</label>
                        <input asp-for="TenSach" class="form-control" required />
                        <span asp-validation-for="TenSach" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label req">ISBN</label>
                        <input asp-for="ISBN" class="form-control" required />
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Barcode</label>
                        <input asp-for="Barcode" class="form-control" placeholder="Để trống = lấy theo Mã sách" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label req">Năm xuất bản</label>
                        <input asp-for="NamXuatBan" type="number" class="form-control" required />
                        <span asp-validation-for="NamXuatBan" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label req">Thể loại</label>
                        <div class="input-group">
                            <select asp-for="MaTheLoai" asp-items="ViewBag.TheLoai" class="form-select" id="selTheLoai" required>
                                <option value="">-- Chọn --</option>
                            </select>
                            <button type="button" class="btn btn-outline-primary" onclick="showAddTheLoai()" title="Thêm thể loại mới">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="MaTheLoai" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label req">Nhà xuất bản</label>
                        <select asp-for="MaNXB" asp-items="ViewBag.NXB" class="form-select" required>
                            <option value="">-- Chọn --</option>
                        </select>
                        <span asp-validation-for="MaNXB" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label req">Kệ sách</label>
                        <select asp-for="MaKe" asp-items="ViewBag.KeSach" class="form-select" required>
                            <option value="">-- Chọn --</option>
                        </select>
                        <span asp-validation-for="MaKe" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label req">Ngôn ngữ</label>
                        <input asp-for="NgonNgu" class="form-control" required />
                        <span asp-validation-for="NgonNgu" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label req">Số trang</label>
                        <input asp-for="SoTrang" type="number" class="form-control" required />
                        <span asp-validation-for="SoTrang" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Số lượng kho</label>
                        <input asp-for="SoLuongKho" type="number" class="form-control bg-light" readonly title="Vào mục Kho để nhập thêm/bớt số lượng" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Số lượng khả dụng</label>
                        <input asp-for="SoLuongKhaDung" type="number" class="form-control bg-light" readonly />
                        <div class="form-text text-muted small"><i class="fa fa-info-circle me-1"></i>Vào mục <strong>Kho</strong> để nhập thêm hoặc xóa cuốn, số lượng ở đây sẽ tự cập nhật theo</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Mô tả</label>
                        <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Nội dung tóm tắt... (không bắt buộc)"></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="form-card mt-3">
                <h6 class="form-card-title">Tác giả</h6>
                <select asp-for="SelectedTacGias" asp-items="ViewBag.TacGias" class="form-select" id="selTacGia" multiple="multiple"></select>
                <div class="form-text text-muted small"><i class="fa fa-info-circle me-1"></i>Gõ để tìm nhanh theo tên, có thể chọn nhiều tác giả cùng lúc</div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="form-card sticky-top" style="top:80px">
                <h6 class="form-card-title">Ảnh bìa</h6>
                <div class="img-upload-zone">
                    @if (!string.IsNullOrEmpty(Model.AnhBia))
                    {
                        <img id="imgPreview" src="/uploads/books/@Model.AnhBia"
                             style="width:100%;border-radius:8px;max-height:280px;object-fit:cover" />
                    }
                    else
                    {
                        <img id="imgPreview" src="#" style="display:none;width:100%;border-radius:8px;max-height:280px;object-fit:cover" />
                        <div id="imgPlaceholder" class="text-center text-muted py-4">
                            <i class="fa fa-image fa-3x mb-2"></i><br>Chưa có ảnh bìa
                        </div>
                    }
                    <input type="file" asp-for="AnhBiaFile" accept="image/*" class="img-input" id="imgInput" />
                </div>
                <div class="mt-4 d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-save me-2"></i>Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Modal thêm thể loại mới -->
<div class="modal fade" id="modalAddTheLoai" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-tag me-2"></i>Thêm thể loại mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên thể loại <span class="text-danger">*</span></label>
                    <input type="text" id="newTenTheLoai" class="form-control" placeholder="VD: Khoa học viễn tưởng" />
                    <div id="tlError" class="text-danger small mt-1" style="display:none"></div>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <textarea id="newMoTaTheLoai" class="form-control" rows="2" placeholder="Mô tả ngắn..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveTheLoai" onclick="saveTheLoai()">
                    <i class="fa fa-save me-1"></i>Lưu thể loại
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
    <script>
        // Ô chọn Tác giả: bật Select2 để có ô tìm kiếm + chọn nhiều tác giả cùng lúc
        // (trước đây là 1 lưới checkbox rất dài, khó tìm khi danh sách tác giả nhiều).
        $('#selTacGia').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: 'Gõ tên để tìm tác giả...',
            allowClear: true,
            language: {
                noResults: function () { return 'Không tìm thấy tác giả nào'; },
                searching: function () { return 'Đang tìm...'; }
            }
        });

        document.getElementById('imgInput').addEventListener('change', function(e) {
            const f = e.target.files[0]; if (!f) return;
            const r = new FileReader();
            r.onload = ev => {
                document.getElementById('imgPreview').src = ev.target.result;
                document.getElementById('imgPreview').style.display = 'block';
                const ph = document.getElementById('imgPlaceholder');
                if (ph) ph.style.display = 'none';
            };
            r.readAsDataURL(f);
        });

        function showAddTheLoai() {
            document.getElementById('newTenTheLoai').value = '';
            document.getElementById('newMoTaTheLoai').value = '';
            document.getElementById('tlError').style.display = 'none';
            new bootstrap.Modal(document.getElementById('modalAddTheLoai')).show();
            setTimeout(() => document.getElementById('newTenTheLoai').focus(), 300);
        }

        async function saveTheLoai() {
            const ten = document.getElementById('newTenTheLoai').value.trim();
            const mota = document.getElementById('newMoTaTheLoai').value.trim();
            const errEl = document.getElementById('tlError');
            const btn = document.getElementById('btnSaveTheLoai');
            if (!ten) { errEl.textContent = 'Vui lòng nhập tên thể loại'; errEl.style.display = ''; return; }
            errEl.style.display = 'none';
            btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Đang lưu...';
            try {
                const res = await fetch('/Books/CreateTheLoaiAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tenTheLoai: ten, moTa: mota })
                });
                const data = await res.json();
                if (!data.success) { errEl.textContent = data.message; errEl.style.display = ''; }
                else {
                    const sel = document.getElementById('selTheLoai');
                    const opt = new Option(data.tenTheLoai, data.maTheLoai, true, true);
                    sel.add(opt);
                    bootstrap.Modal.getInstance(document.getElementById('modalAddTheLoai')).hide();
                }
            } catch(e) { errEl.textContent = 'Lỗi kết nối máy chủ'; errEl.style.display = ''; }
            finally { btn.disabled = false; btn.innerHTML = '<i class="fa fa-save me-1"></i>Lưu thể loại'; }
        }
        document.getElementById('newTenTheLoai')?.addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); saveTheLoai(); }
        });
    </script>
}
