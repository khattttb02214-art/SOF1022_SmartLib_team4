@model SmartLib.Web.Models.KeSach
@{ ViewData["Title"] = "Chi tiết kệ sách — " + Model.TenKe; }

<div class="page-header-card d-flex align-items-center gap-3">
    <a asp-action="KeSach" class="btn btn-outline-secondary btn-sm"><i class="fa fa-arrow-left"></i></a>
    <div>
        <h4 class="mb-0"><i class="fa fa-map-pin me-2 text-primary"></i>@Model.TenKe</h4>
        <div class="text-muted small">
            @if (Model.Tang.HasValue) { <span><i class="fa fa-layer-group fa-xs me-1"></i>Tầng @Model.Tang</span> }
            @if (!string.IsNullOrEmpty(Model.Phong)) { <span class="ms-2"><i class="fa fa-door-open fa-xs me-1"></i>@Model.Phong</span> }
            @if (!string.IsNullOrEmpty(Model.ViTri)) { <span class="ms-2"><i class="fa fa-location-dot fa-xs me-1"></i>@Model.ViTri</span> }
        </div>
    </div>
    <div class="ms-auto">
        <a asp-action="SuaKe" asp-route-id="@Model.MaKe" class="btn btn-warning btn-sm"><i class="fa fa-pen me-1"></i>Sửa</a>
    </div>
</div>

<div class="row g-4">
    <!-- Info card -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold text-primary mb-3"><i class="fa fa-info-circle me-2"></i>Thông tin kệ</h6>
                <table class="table table-sm mb-0">
                    <tr><td class="text-muted">Mã kệ</td><td class="fw-semibold">@Model.MaKe</td></tr>
                    <tr><td class="text-muted">Tầng</td><td>@(Model.Tang?.ToString() ?? "—")</td></tr>
                    <tr><td class="text-muted">Phòng</td><td>@(Model.Phong ?? "—")</td></tr>
                    <tr><td class="text-muted">Vị trí</td><td>@(Model.ViTri ?? "—")</td></tr>
                    <tr><td class="text-muted">Sức chứa</td><td>@(Model.SucChua?.ToString() ?? "Không giới hạn")</td></tr>
                    <tr>
                        <td class="text-muted">Trạng thái</td>
                        <td><span class="badge @(Model.TrangThai?"bg-success":"bg-secondary")">@(Model.TrangThai?"Đang dùng":"Ngưng dùng")</span></td>
                    </tr>
                    @if (Model.TheLoaiPhuTrach != null)
                    {
                    { <tr><td class="text-muted">Thể loại</td><td><span class="badge bg-primary-soft">@Model.TheLoaiPhuTrach.TenTheLoai</span></td></tr> }
                    }
                    @if (Model.NXBPhuTrach != null)
                    {
                    { <tr><td class="text-muted">NXB</td><td><span class="badge" style="background:#fff7ed;color:#c2410c">@Model.NXBPhuTrach.TenNXB</span></td></tr> }
                    }
                </table>
                @if (!string.IsNullOrEmpty(Model.MoTa))
                {
                    <div class="mt-3 p-2 bg-light rounded" style="font-size:12.5px;color:#6b7280;font-style:italic">
                        @Model.MoTa
                    </div>
                }
            </div>
        </div>

        <!-- Stats -->
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body">
                <h6 class="fw-bold text-primary mb-3"><i class="fa fa-chart-bar me-2"></i>Thống kê</h6>
                @{
                    var saches = Model.Saches.Where(s => s.TrangThai).ToList();
                    var tongCuon = saches.Sum(s => s.CuonSaches.Count);
                    var dangMuon = saches.Sum(s => s.CuonSaches.Count(c => c.TrangThai == "Đang Mượn"));
                    var khaDung  = saches.Sum(s => s.SoLuongKhaDung);
                }
                <div class="d-flex gap-3 text-center">
                    <div class="flex-fill p-2 rounded" style="background:#eff6ff">
                        <div class="fw-bold fs-5 text-primary">@saches.Count</div>
                        <div class="small text-muted">Đầu sách</div>
                    </div>
                    <div class="flex-fill p-2 rounded" style="background:#f0fdf4">
                        <div class="fw-bold fs-5 text-success">@khaDung</div>
                        <div class="small text-muted">Khả dụng</div>
                    </div>
                    <div class="flex-fill p-2 rounded" style="background:#fff7ed">
                        <div class="fw-bold fs-5 text-warning">@dangMuon</div>
                        <div class="small text-muted">Đang mượn</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách sách trên kệ -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h6 class="fw-bold mb-0"><i class="fa fa-book me-2 text-primary"></i>Sách trên kệ (@saches.Count đầu sách)</h6>
            </div>
            <div class="card-body p-0">
                @if (!saches.Any())
                {
                    <div class="text-center py-5 text-muted"><i class="fa fa-box-open fa-2x mb-2 d-block"></i>Kệ chưa có sách</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Ảnh</th><th>Tên sách</th><th>Thể loại</th><th>Kho</th><th>Khả dụng</th><th>Đang mượn</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var s in saches.OrderBy(s => s.TenSach))
                                {
                                    var dm = s.CuonSaches.Count(c => c.TrangThai == "Đang Mượn");
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(s.AnhBia))
                                            {
                                            { <img src="/uploads/books/@s.AnhBia" width="36" height="46" style="object-fit:cover;border-radius:6px" /> }
                                            }
                                            else
                                            { <div style="width:36px;height:46px;background:#e8edf8;border-radius:6px;display:flex;align-items:center;justify-content:center"><i class="fa fa-book text-secondary fa-xs"></i></div> }
                                        </td>
                                        <td><a asp-controller="Books" asp-action="Detail" asp-route-id="@s.MaSach" class="fw-semibold text-decoration-none">@s.TenSach</a></td>
                                        <td><span class="badge bg-primary-soft">@(s.TheLoai?.TenTheLoai ?? "—")</span></td>
                                        <td class="fw-semibold">@s.SoLuongKho</td>
                                        <td><span class="fw-semibold @(s.SoLuongKhaDung==0?"text-danger":s.SoLuongKhaDung<3?"text-warning":"text-success")">@s.SoLuongKhaDung</span></td>
                                        <td><span class="text-info fw-semibold">@dm</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
