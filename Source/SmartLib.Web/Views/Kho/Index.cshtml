@model List<SmartLib.Web.ViewModels.KhoViewModel>
@{
    ViewData["Title"] = "Quản lý kho";
}
<div class="page-header-card d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h4 class="mb-0"><i class="fa fa-warehouse me-2"></i>Quản lý kho sách</h4>
    <form asp-action="SyncTatCa" method="post" class="d-inline"
          onsubmit="return confirm('Đồng bộ SoLuongKhaDung cho tất cả sách từ dữ liệu CuonSach?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-warning btn-sm">
            <i class="fa fa-rotate me-1"></i>Đồng bộ số lượng
        </button>
    </form>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="kho-stat-card blue"><div class="kho-stat-num">@ViewBag.TongSach</div><div class="kho-stat-label">Tổng đầu sách</div></div></div>
    <div class="col-6 col-md-3"><div class="kho-stat-card red"><div class="kho-stat-num">@ViewBag.HetSach</div><div class="kho-stat-label">Hết sách</div></div></div>
    <div class="col-6 col-md-3"><div class="kho-stat-card orange"><div class="kho-stat-num">@ViewBag.SapHet</div><div class="kho-stat-label">Sắp hết (< 3)</div></div></div>
    <div class="col-6 col-md-3"><div class="kho-stat-card green"><div class="kho-stat-num">@ViewBag.DangMuon</div><div class="kho-stat-label">Đang cho mượn</div></div></div>
</div>
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-sm @(ViewBag.Filter == null ? "btn-primary" : "btn-outline-primary")">Tất cả</a>
            <a asp-action="Index" asp-route-filter="het" class="btn btn-sm @(ViewBag.Filter == "het" ? "btn-danger" : "btn-outline-danger")">Hết sách</a>
            <a asp-action="Index" asp-route-filter="saphet" class="btn btn-sm @(ViewBag.Filter == "saphet" ? "btn-warning" : "btn-outline-warning")">Sắp hết</a>
            <a asp-action="Index" asp-route-filter="muon" class="btn btn-sm @(ViewBag.Filter == "muon" ? "btn-info" : "btn-outline-info")">Đang cho mượn</a>
        </div>
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="khoTable">
            <thead class="table-light">
                <tr><th>Ảnh</th><th>Tên sách</th><th>Thể loại</th><th>Kho</th><th>Khả dụng</th><th>Đang mượn</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(k.AnhBia))
                            {
                                {
                                    <img src="/uploads/books/@k.AnhBia" width="40" height="52" style="object-fit:cover;border-radius:6px" />
                                }
                            }
                            else
                            {

                                <div style="width:40px;height:52px;background:#e8edf8;border-radius:6px;display:flex;align-items:center;justify-content:center"><i class="fa fa-book text-secondary"></i></div>
                            }
                        </td>
                        <td>
                            <a asp-controller="Books" asp-action="Detail" asp-route-id="@k.MaSach" class="fw-semibold text-decoration-none">@k.TenSach</a>
                        </td>
                        <td><span class="badge bg-primary-soft">@(k.TenTheLoai ?? "—")</span></td>
                        <td><span class="fw-semibold">@k.SoLuongKho</span></td>
                        <td><span class="fw-semibold @(k.SoLuongKhaDung == 0 ? "text-danger" : k.SoLuongKhaDung < 3 ? "text-warning" : "text-success")">@k.SoLuongKhaDung</span></td>
                        <td><span class="text-info fw-semibold">@k.DangMuon</span></td>
                        <td>
                            <span class="badge @(k.TrangThai == "Còn hàng" ? "bg-success" : k.TrangThai == "Sắp hết" ? "bg-warning text-dark" : "bg-danger")">
                                @k.TrangThai
                            </span>
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="DanhSachCuon" asp-route-maSach="@k.MaSach"
                               class="btn btn-xs btn-outline-primary">
                                <i class="fa fa-layer-group me-1"></i>Cuốn
                            </a>
                            <form asp-action="NgungHoatDongSach" method="post" class="d-inline"
                                  onsubmit="return confirm('Ngừng hoạt động sách &quot;@k.TenSach&quot;?\nSách sẽ bị ẩn hoàn toàn khỏi kho và không cho độc giả thấy nữa (dữ liệu vẫn được giữ nguyên).')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maSach" value="@k.MaSach" />
                                <button type="submit" class="btn btn-xs btn-outline-danger" title="Ngừng hoạt động — ẩn sách khỏi người dùng">
                                    <i class="fa fa-ban me-1"></i>Ngừng
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>$('#khoTable').DataTable({language:{url:'//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'},pageLength:25});</script>
}
