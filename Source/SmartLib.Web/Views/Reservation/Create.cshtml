@{
    ViewData["Title"] = "Tạo đặt trước";
}
<div class="page-header-card"><h4><i class="fa fa-bookmark me-2"></i>Tạo đặt trước</h4></div>

<form asp-action="Create" method="post" id="resForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="MaSach" id="hidMaSach" />

    <div class="row g-4">
        <div class="col-lg-8">

            <!-- Thông tin -->
            <div class="form-card">
                <h6 class="form-card-title">Thông tin đặt trước</h6>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label req">Độc giả</label>
                        <select name="MaDocGia" asp-items="ViewBag.DocGia"
                                class="form-select" required>
                            <option value="">-- Chọn độc giả --</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Tìm & chọn sách -->
            <div class="form-card mt-3">
                <h6 class="form-card-title">
                    Tìm &amp; chọn sách
                    <span class="text-muted small fw-normal">– Đặt trước 1 đầu sách mỗi lần</span>
                </h6>

                <div class="d-flex gap-2 mb-3">
                    <input type="text" id="sachSearch" class="form-control"
                           placeholder="Nhập tên sách, mã sách, ISBN..." autocomplete="off" />
                    <button type="button" class="btn btn-outline-primary" onclick="doSearch()">
                        <i class="fa fa-search"></i>
                    </button>
                </div>

                <div id="searchResults" class="mb-3"></div>

                <!-- Sách đã chọn -->
                <div id="selectedSach" class="d-none">
                    <div class="alert alert-success d-flex align-items-center gap-3 py-2 mb-0">
                        <i class="fa fa-book-open fa-lg text-success"></i>
                        <div class="flex-fill">
                            <div class="fw-semibold" id="selTenSach">—</div>
                            <small class="text-muted" id="selMaSach">—</small>
                            <small id="selCoSanInfo" class="ms-2"></small>
                        </div>
                        <button type="button" class="btn btn-xs btn-outline-danger" onclick="clearSach()">
                            <i class="fa fa-xmark"></i>
                        </button>
                    </div>
                </div>
                <div id="noSachMsg" class="text-muted small mt-1" style="display:none">
                    Vui lòng chọn sách để tiếp tục.
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-card sticky-top" style="top:80px">
                <div id="resSummary" class="mb-3 text-muted small">Chưa chọn sách nào</div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg"
                            id="submitBtn" disabled>
                        <i class="fa fa-bookmark me-2"></i>Tạo đặt trước
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let searchTimer = null;

        function escHtml(s) {
            if (!s) return '';
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
        }

        async function doSearch() {
            const kw = document.getElementById('sachSearch').value.trim();
            const div = document.getElementById('searchResults');
            if (!kw) { div.innerHTML = ''; return; }

            div.innerHTML = '<p class="text-muted small"><i class="fa fa-spinner fa-spin me-1"></i>Đang tìm...</p>';
            try {
                const res  = await fetch('/Reservation/SearchSach?q=' + encodeURIComponent(kw));
                const list = await res.json();

                if (!list.length) {
                    div.innerHTML = '<p class="text-muted small"><i class="fa fa-circle-info me-1"></i>Không tìm thấy sách nào.</p>';
                    return;
                }

                window._sachResults = list;
                div.innerHTML = list.map((s, i) => {
                    const coSanBadge = s.soLuongCoSan > 0
                        ? `<span class="badge bg-success ms-auto">${s.soLuongCoSan} cuốn sẵn</span>`
                        : `<span class="badge bg-warning text-dark ms-auto">Hết sẵn</span>`;
                    return `
                    <div class="search-result-item" style="cursor:pointer" onclick="pickSach(${i})">
                        <i class="fa fa-book text-primary me-2"></i>
                        <span class="fw-semibold flex-fill">${escHtml(s.tenSach)}</span>
                        <small class="text-muted me-2">${escHtml(s.maSach)}</small>
                        ${coSanBadge}
                    </div>`;
                }).join('');
            } catch (e) {
                div.innerHTML = '<p class="text-danger small">Lỗi kết nối: ' + e.message + '</p>';
            }
        }

        function pickSach(idx) {
            const s = (window._sachResults || [])[idx];
            if (!s) return;

            document.getElementById('hidMaSach').value = s.maSach;
            document.getElementById('selTenSach').textContent = s.tenSach;
            document.getElementById('selMaSach').textContent  = 'Mã: ' + s.maSach;

            const coSanEl = document.getElementById('selCoSanInfo');
            if (s.soLuongCoSan > 0) {
                coSanEl.innerHTML = `<span class="badge bg-success-soft">${s.soLuongCoSan} cuốn sẵn</span>`;
            } else {
                coSanEl.innerHTML = `<span class="badge bg-warning-soft text-warning">⚠️ Hiện hết sẵn – vẫn có thể đặt trước</span>`;
            }

            document.getElementById('selectedSach').classList.remove('d-none');
            document.getElementById('searchResults').innerHTML = '';
            document.getElementById('sachSearch').value = '';
            document.getElementById('resSummary').textContent = 'Sách: ' + s.tenSach;
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('noSachMsg').style.display = 'none';
        }

        function clearSach() {
            document.getElementById('hidMaSach').value = '';
            document.getElementById('selectedSach').classList.add('d-none');
            document.getElementById('resSummary').textContent = 'Chưa chọn sách nào';
            document.getElementById('submitBtn').disabled = true;
        }

        document.getElementById('sachSearch').addEventListener('input', () => {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(doSearch, 400);
        });
        document.getElementById('sachSearch').addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); clearTimeout(searchTimer); doSearch(); }
        });

        document.getElementById('resForm').addEventListener('submit', e => {
            if (!document.getElementById('hidMaSach').value) {
                e.preventDefault();
                document.getElementById('noSachMsg').style.display = '';
                document.getElementById('sachSearch').focus();
            }
        });
    </script>
}
