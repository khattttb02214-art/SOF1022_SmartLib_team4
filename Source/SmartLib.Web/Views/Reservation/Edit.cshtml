@model SmartLib.Web.ViewModels.ReservationViewModel
@{ ViewData["Title"] = $"Sửa đặt trước #{Model.MaReservation}"; }

<div class="page-header-card d-flex justify-content-between align-items-center mb-3">
	<h4 class="mb-0"><i class="fa fa-pencil-square me-2"></i>Sửa phiếu đặt trước</h4>
	<a asp-action="Index" class="btn btn-secondary btn-sm">
		<i class="fa fa-arrow-left me-1"></i>Quay lại
	</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.MaReservation" method="post" class="card shadow-sm">
	@Html.AntiForgeryToken()

	<div class="card-body">
		<!-- Mã đặt trước -->
		<div class="alert alert-info mb-3">
			<i class="fa fa-info-circle me-2"></i>
			Mã đặt trước: <strong>#@Model.MaReservation</strong> | 
			Ngày tạo: <strong>@($"{Model.NgayDat:dd/MM/yyyy HH:mm}")</strong>
		</div>

		<!-- Chọn độc giả -->
		<div class="mb-3">
			<label class="form-label fw-semibold">
				<i class="fa fa-user me-2"></i>Độc giả <span class="text-danger">*</span>
			</label>
			<select name="MaDocGia" class="form-select form-select-lg" required>
				<option value="">-- Chọn độc giả --</option>
				@foreach (var dg in (SelectList)ViewBag.DocGia)
				{
					<option value="@dg.Value" selected="@(dg.Value?.ToString() == Model.MaDocGia)">@dg.Text</option>
				}
			</select>
		</div>

		<!-- Trạng thái -->
		<div class="mb-3">
			<label class="form-label fw-semibold">
				<i class="fa fa-flag me-2"></i>Trạng thái <span class="text-danger">*</span>
			</label>
			<select name="TrangThai" class="form-select form-select-lg" required>
				@foreach (var status in (SelectList)ViewBag.StatusList)
				{
					<option value="@status.Value" selected="@(status.Value == Model.TrangThai)">@status.Text</option>
				}
			</select>
		</div>

		<hr />

		<!-- Chọn sách -->
		<div class="mb-3">
			<label class="form-label fw-semibold">
				<i class="fa fa-book me-2"></i>Danh sách sách <span class="text-danger">*</span>
			</label>
			<div class="input-group mb-2">
				<input type="text" id="bookSearch" class="form-control form-control-lg" 
					   placeholder="Tìm kiếm sách (tên, mã, ISBN)..." />
				<button type="button" class="btn btn-outline-secondary" id="btnSearchBook">
					<i class="fa fa-search"></i>
				</button>
			</div>
			<div id="bookResults" class="list-group mb-3" style="display:none; max-height: 300px; overflow-y: auto;"></div>
		</div>

		<!-- Bảng sách đã chọn -->
		<div class="mb-3">
			<label class="form-label fw-semibold">
				<i class="fa fa-list me-2"></i>Sách đã chọn
			</label>
			<div class="table-responsive">
				<table class="table table-sm table-hover" id="selectedBooksTable">
					<thead class="table-light">
						<tr>
							<th>Sách</th>
							<th style="width: 100px;">SL</th>
							<th style="width: 80px;" class="text-center">Thao tác</th>
						</tr>
					</thead>
					<tbody id="selectedBooksList">
						<tr id="emptyRow">
							<td colspan="3" class="text-center text-muted py-4">
								<i class="fa fa-inbox fa-2x d-block mb-2 opacity-50"></i>
								Chưa chọn sách nào
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<hr />

		<!-- Ghi chú -->
		<div class="mb-3">
			<label for="GhiChu" class="form-label">
				<i class="fa fa-note-sticky me-2"></i>Ghi chú
			</label>
			<textarea id="GhiChu" name="GhiChu" class="form-control" rows="3" 
					  placeholder="Ghi chú thêm về phiếu đặt trước (tùy chọn)">@Model.GhiChu</textarea>
		</div>
	</div>

	<div class="card-footer bg-light d-flex justify-content-end gap-2">
		<a asp-action="Index" class="btn btn-secondary">
			<i class="fa fa-times me-1"></i>Hủy
		</a>
		<button type="submit" class="btn btn-primary" id="btnSubmit" disabled>
			<i class="fa fa-check me-1"></i>Cập nhật
		</button>
	</div>
</form>

<!-- Hidden input để lưu danh sách sách -->
<input type="hidden" name="SelectedBooks" id="SelectedBooks" />

@section Scripts {
	<script>
		const selectedBooks = {}; // { maSach: { tenSach, soLuong } }

		// Khởi tạo sách đã chọn
		function initializeSelectedBooks() {
			@foreach (var item in Model.ChiTietList)
			{
				<text>
					selectedBooks['@item.MaSach'] = {
						tenSach: '@item.TenSach.Replace("'", "\\'")`,
						soLuong: @item.SoLuong,
						soLuongCoSan: 0
					};
				</text>
			}
			updateTable();
		}

		// Tìm kiếm sách
		document.getElementById('btnSearchBook').addEventListener('click', async () => {
			const q = document.getElementById('bookSearch').value.trim();
			if (!q) return alert('Vui lòng nhập từ khóa tìm kiếm');

			try {
				const response = await fetch('@Url.Action("SearchSach", "Reservation")' + '?q=' + encodeURIComponent(q));
				const data = await response.json();
				const resultsDiv = document.getElementById('bookResults');

				if (!data || data.length === 0) {
					resultsDiv.innerHTML = '<div class="p-2 text-muted">Không tìm thấy sách</div>';
				} else {
					resultsDiv.innerHTML = data.map(s => `
						<button type="button" class="list-group-item list-group-item-action" 
								onclick="addBook('${s.maSach}', '${s.tenSach.replace(/'/g, "\\'")}', ${s.soLuongCoSan})">
							<div class="d-flex justify-content-between align-items-start">
								<div>
									<strong>${s.tenSach}</strong><br />
									<small class="text-muted">${s.maSach}</small>
								</div>
								<span class="badge ${s.coSan ? 'bg-success' : 'bg-danger'}">
									${s.soLuongCoSan} cuốn
								</span>
							</div>
						</button>
					`).join('');
				}
				resultsDiv.style.display = 'block';
			} catch (err) {
				alert('Lỗi tìm kiếm: ' + err.message);
			}
		});

		// Thêm sách vào danh sách
		function addBook(maSach, tenSach, soLuongCoSan) {
			if (selectedBooks[maSach]) {
				alert('Sách này đã được chọn');
				return;
			}

			selectedBooks[maSach] = { tenSach, soLuong: 1, soLuongCoSan };
			updateTable();
			document.getElementById('bookSearch').value = '';
			document.getElementById('bookResults').style.display = 'none';
		}

		// Cập nhật bảng
		function updateTable() {
			const tbody = document.getElementById('selectedBooksList');
			const emptyRow = document.getElementById('emptyRow');

			if (Object.keys(selectedBooks).length === 0) {
				emptyRow.style.display = '';
				return;
			}

			emptyRow.style.display = 'none';
			tbody.innerHTML = Object.entries(selectedBooks).map(([maSach, item]) => `
				<tr>
					<td>
						<strong>${item.tenSach}</strong><br />
						<small class="text-muted">${maSach}</small>
					</td>
					<td>
						<input type="number" class="form-control" value="${item.soLuong}" min="1" 
							   onchange="updateQuantity('${maSach}', this.value)">
					</td>
					<td class="text-center">
						<button type="button" class="btn btn-sm btn-outline-danger" 
								onclick="removeBook('${maSach}')">
							<i class="fa fa-trash"></i>
						</button>
					</td>
				</tr>
			`).join('');

			updateSubmitButton();
		}

		// Cập nhật số lượng
		function updateQuantity(maSach, value) {
			selectedBooks[maSach].soLuong = parseInt(value) || 1;
		}

		// Xóa sách
		function removeBook(maSach) {
			delete selectedBooks[maSach];
			updateTable();
		}

		// Cập nhật nút Cập nhật
		function updateSubmitButton() {
			const btnSubmit = document.getElementById('btnSubmit');
			const hasBooks = Object.keys(selectedBooks).length > 0;
			btnSubmit.disabled = !hasBooks;

			// Cập nhật hidden input
			document.getElementById('SelectedBooks').value = Object.keys(selectedBooks).join(',');
		}

		// Form submit
		document.querySelector('form').addEventListener('submit', (e) => {
			// Tạo hidden inputs cho selected books
			const container = document.querySelectorAll('input[name="SelectedBooks[]"]');
			container.forEach(el => el.remove());

			Object.keys(selectedBooks).forEach(maSach => {
				const input = document.createElement('input');
				input.type = 'hidden';
				input.name = 'SelectedBooks';
				input.value = maSach;
				document.querySelector('form').appendChild(input);
			});
		});

		// Enter key search
		document.getElementById('bookSearch').addEventListener('keypress', (e) => {
			if (e.key === 'Enter') {
				e.preventDefault();
				document.getElementById('btnSearchBook').click();
			}
		});

		// Initialize on page load
		initializeSelectedBooks();
	</script>
}
