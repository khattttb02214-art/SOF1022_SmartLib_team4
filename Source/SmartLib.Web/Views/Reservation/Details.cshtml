@model SmartLib.Web.Models.Reservation
@{ ViewData["Title"] = $"Chi tiết đặt trước #{Model.MaReservation}"; }

<div class="page-header-card d-flex justify-content-between align-items-center mb-3">
	<h4 class="mb-0"><i class="fa fa-bookmark me-2"></i>Chi tiết đặt trước</h4>
	@if (User.IsInRole("ADMIN") || User.IsInRole("LIB"))
	{
		<div class="d-flex gap-2">
			<a asp-action="Edit" asp-route-id="@Model.MaReservation" class="btn btn-primary btn-sm">
				<i class="fa fa-pen me-1"></i>Sửa
			</a>
			<a asp-action="Index" class="btn btn-secondary btn-sm">
				<i class="fa fa-arrow-left me-1"></i>Quay lại
			</a>
		</div>
	}
	else
	{
		<a asp-action="Index" class="btn btn-secondary btn-sm">
			<i class="fa fa-arrow-left me-1"></i>Quay lại
		</a>
	}
</div>

<div class="row mb-3">
	<div class="col-md-6">
		<div class="card shadow-sm">
			<div class="card-header bg-light">
				<h6 class="mb-0"><i class="fa fa-info-circle me-2"></i>Thông tin đặt trước</h6>
			</div>
			<div class="card-body">
				<div class="row mb-3">
					<div class="col-sm-5"><strong>Mã đặt trước:</strong></div>
					<div class="col-sm-7">
						<code class="text-danger">@Model.MaReservation</code>
					</div>
				</div>

				<div class="row mb-3">
					<div class="col-sm-5"><strong>Trạng thái:</strong></div>
					<div class="col-sm-7">
						<span class="badge @(Model.TrangThai=="Đã Duyệt" ? "bg-success"
											   : Model.TrangThai=="Đã Hủy"  ? "bg-danger"
											   : "bg-warning text-dark")">
							@Model.TrangThai
						</span>
					</div>
				</div>

				<div class="row mb-3">
					<div class="col-sm-5"><strong>Ngày đặt:</strong></div>
					<div class="col-sm-7">
						@($"{Model.NgayDat:dd/MM/yyyy HH:mm}")
					</div>
				</div>

				<hr />

				<div class="row mb-3">
					<div class="col-sm-5"><strong>Độc giả:</strong></div>
					<div class="col-sm-7">
						@if (Model.DocGia != null)
						{
							<a href="@Url.Action("Details", "Reader", new { id = Model.DocGia.MaDocGia })" 
							   title="Xem hồ sơ">
								<strong>@Model.DocGia.HoTen</strong><br />
								<small class="text-muted">@Model.DocGia.MaDocGia</small>
							</a>
						}
						else
						{
							<span class="text-muted">—</span>
						}
					</div>
				</div>

				<div class="row mb-3">
					<div class="col-sm-5"><strong>Nhân viên xử lý:</strong></div>
					<div class="col-sm-7">
						@if (Model.NhanVien != null)
						{
							<strong>@Model.NhanVien.HoTen</strong><br />
							<small class="text-muted">@Model.MaNV</small>
						}
						else
						{
							<span class="text-muted">Chưa gán</span>
						}
					</div>
				</div>

				@if (!string.IsNullOrEmpty(Model.GhiChu))
				{
					<div class="row mb-3">
						<div class="col-sm-5"><strong>Ghi chú:</strong></div>
						<div class="col-sm-7">
							<div class="alert alert-info small mb-0">
								@Model.GhiChu
							</div>
						</div>
					</div>
				}

				@if (Model.TrangThai == "Đã Duyệt" && Model.DaMuon)
				{
					<hr />
					<div class="row mb-3">
						<div class="col-sm-5"><strong>Phiếu mượn:</strong></div>
						<div class="col-sm-7">
							<a asp-controller="Borrow" asp-action="Details" asp-route-id="@Model.MaPhieuMuon">
								<i class="fa fa-arrow-up-right-from-square me-1"></i>@Model.MaPhieuMuon
							</a>
						</div>
					</div>
				}
			</div>
		</div>
	</div>

	<div class="col-md-6">
		<div class="card shadow-sm">
			<div class="card-header bg-light">
				<h6 class="mb-0"><i class="fa fa-book me-2"></i>Danh sách sách (@Model.ChiTietDatTruocs.Count)</h6>
			</div>
			<div class="card-body p-0">
				@if (Model.ChiTietDatTruocs.Any())
				{
					<table class="table table-sm mb-0">
						<thead class="table-light">
							<tr>
								<th>Sách</th>
								<th class="text-center" style="width: 80px;">SL</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.ChiTietDatTruocs)
							{
								<tr>
									<td>
										@if (item.Sach != null)
										{
											<strong>@item.Sach.TenSach</strong><br />
											<small class="text-muted">@item.MaSach</small>
										}
										else
										{
											<span class="text-danger">@item.MaSach (sách không tồn tại)</span>
										}
										@if (!string.IsNullOrEmpty(item.GhiChu))
										{
											<br /><small class="text-info"><i class="fa fa-comment me-1"></i>@item.GhiChu</small>
										}
									</td>
									<td class="text-center fw-semibold">
										@item.SoLuong
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				else
				{
					<div class="p-3 text-center text-muted">
						<i class="fa fa-inbox fa-2x mb-2 d-block opacity-50"></i>
						Không có sách nào
					</div>
				}
			</div>
		</div>
	</div>
</div>

<div class="card shadow-sm">
	<div class="card-body py-2 text-end">
		@if (User.IsInRole("ADMIN") || User.IsInRole("LIB"))
		{
			@if (Model.TrangThai == "Đang Chờ")
			{
				<a asp-action="Approve" asp-route-id="@Model.MaReservation" class="btn btn-success btn-sm"
				   onclick="return confirm('Duyệt đặt trước này?')">
					<i class="fa fa-check me-1"></i>Duyệt
				</a>
				<a asp-action="Cancel" asp-route-id="@Model.MaReservation" class="btn btn-outline-warning btn-sm"
				   onclick="return confirm('Hủy đặt trước này?')">
					<i class="fa fa-ban me-1"></i>Hủy
				</a>
			}
			else if (Model.TrangThai == "Đã Duyệt" && !Model.DaMuon)
			{
				<a asp-action="CreateBorrow" asp-route-id="@Model.MaReservation" class="btn btn-primary btn-sm"
				   onclick="return confirm('Lập phiếu mượn cho đặt trước này?')">
					<i class="fa fa-file-circle-plus me-1"></i>Lập phiếu mượn
				</a>
			}
			<a asp-action="Edit" asp-route-id="@Model.MaReservation" class="btn btn-outline-primary btn-sm">
				<i class="fa fa-pen me-1"></i>Sửa
			</a>
			<button onclick="confirmDelete('/Reservation/Delete/@Model.MaReservation')" class="btn btn-outline-danger btn-sm">
				<i class="fa fa-trash me-1"></i>Xóa
			</button>
		}
	</div>
</div>

@section Scripts {
	<script>
		function confirmDelete(url) {
			Swal.fire({
				title: 'Xóa đặt trước?', icon: 'warning',
				showCancelButton: true, confirmButtonColor: '#d33',
				cancelButtonText: 'Hủy', confirmButtonText: 'Xóa'
			}).then(r => { if (r.isConfirmed) window.location.href = url; });
		}
	</script>
}
