@{ ViewData["Title"] = "Hoàn tất đăng ký"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page">
    <div class="auth-card" style="max-width:520px">

        <div class="text-center mb-3">
            <div class="auth-logo">
                <svg width="36" height="36" viewBox="0 0 48 48" style="display:block;margin:auto;">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
            </div>
            <h3 class="auth-title">Hoàn tất đăng ký</h3>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-1"
                 style="background:#f0fdf4;border:1px solid #86efac;font-size:13px;color:#166534;">
                <i class="fa fa-circle-check"></i>
                Email <strong>@ViewBag.Email</strong> đã xác minh ✅
            </div>
            <p class="auth-sub mt-1">Điền thông tin bên dưới để tạo tài khoản thư viện</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center small">
                <i class="fa fa-circle-exclamation me-1"></i>@ViewBag.Error
            </div>
        }

        <form asp-action="GoogleLinkCard" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">

                @* Họ tên lấy từ Google, hiển thị sẵn nhưng vẫn cho sửa *@
                <div class="col-12">
                    <label class="form-label req">Họ và tên</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa fa-user"></i></span>
                        <input type="text" name="HoTen" class="form-control"
                               value="@ViewBag.Name" placeholder="Nguyễn Văn A" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Số điện thoại</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa fa-phone"></i></span>
                        <input type="text" name="SoDienThoai" class="form-control" placeholder="0912 345 678" />
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Lớp</label>
                    <input type="text" name="Lop" class="form-control" placeholder="VD: CNTT01" />
                </div>

                <div class="col-12">
                    <label class="form-label">Khoa</label>
                    <input type="text" name="Khoa" class="form-control" placeholder="VD: Công nghệ thông tin" />
                </div>

                <div class="col-12">
                    <label class="form-label req">
                        Mã thẻ thư viện
                        <span class="text-muted small fw-normal">(bắt buộc)</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa fa-id-card"></i></span>
                        <input type="text" name="MaTheTV" id="maTheInput"
                               class="form-control font-monospace text-uppercase"
                               placeholder="VD: THE00001" required />
                        <button type="button" class="btn btn-outline-secondary" id="btnCheckThe">
                            <i class="fa fa-magnifying-glass"></i>
                        </button>
                    </div>
                    <div id="theStatus" class="mt-1 small"></div>
                    <small class="text-muted">Liên hệ thủ thư nếu chưa có thẻ.</small>
                </div>

                <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-primary w-100 btn-lg">
                        <i class="fa fa-check me-2"></i>Hoàn tất đăng ký
                    </button>
                </div>

                <div class="col-12 text-center">
                    <small><a asp-action="Login">Hủy và quay về đăng nhập</a></small>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    document.getElementById('maTheInput').addEventListener('input', function () {
        this.value = this.value.toUpperCase();
        document.getElementById('theStatus').textContent = '';
    });

    document.getElementById('btnCheckThe').addEventListener('click', async function () {
        const ma = document.getElementById('maTheInput').value.trim();
        const el = document.getElementById('theStatus');
        if (!ma) { el.innerHTML = '<span class="text-warning">Vui lòng nhập mã thẻ.</span>'; return; }
        el.innerHTML = '<span class="text-muted"><i class="fa fa-spinner fa-spin me-1"></i>Đang kiểm tra...</span>';
        try {
            const res = await fetch(`/Auth/CheckCard?ma=${encodeURIComponent(ma)}`);
            const data = await res.json();
            if (data.ok) el.innerHTML = '<span class="text-success"><i class="fa fa-check me-1"></i>' + data.message + '</span>';
            else         el.innerHTML = '<span class="text-danger"><i class="fa fa-xmark me-1"></i>' + data.message + '</span>';
        } catch { el.innerHTML = '<span class="text-danger">Lỗi kiểm tra thẻ.</span>'; }
    });
});
</script>
}
