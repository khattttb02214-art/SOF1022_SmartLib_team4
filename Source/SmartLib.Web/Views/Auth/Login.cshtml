@model SmartLib.Web.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo"><i class="fa fa-book-open"></i></div>
        <h3 class="auth-title">Chào mừng trở lại!</h3>
        <p class="auth-sub">Đăng nhập vào SmartLib</p>

        @if (TempData["VerifySuccess"] != null)
        {
            <div class="alert alert-success py-2 text-sm">
                <i class="fa fa-circle-check me-1"></i>
                <strong>Xác minh email thành công!</strong> Tài khoản đang chờ thủ thư phê duyệt.
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 text-sm">
                <i class="fa fa-circle-exclamation me-1"></i>@ViewBag.Error
            </div>
            @if (ViewBag.ShowResendVerify == true)
            {
                <form method="post" asp-controller="Auth" asp-action="ResendVerifyOtp" class="text-center mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@ViewBag.PendingEmail" />
                    <button type="submit" class="btn btn-sm btn-outline-primary mt-1">
                        <i class="fa fa-envelope me-1"></i>Gửi lại email xác minh
                    </button>
                </form>
            }
        }

        <form method="post" asp-action="Login">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-envelope text-muted"></i></span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="admin@gmail.com" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">
                <i class="fa fa-right-to-bracket me-2"></i>Đăng nhập
            </button>
        </form>

        <p class="text-center mt-3 text-muted small">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>

        <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1" /><span class="px-2 text-muted small">hoặc</span><hr class="flex-grow-1" />
        </div>

        <a asp-action="GoogleLogin" asp-route-source="login"
           class="btn w-100 d-flex align-items-center justify-content-center gap-2"
           style="border:1.5px solid #dadce0;background:#fff;color:#3c4043;font-weight:500;padding:10px;border-radius:8px;">
            <svg width="20" height="20" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Đăng nhập bằng Google
        </a>

        <div class="mt-4 p-3 bg-light rounded-3 small text-muted">
            <strong>Tài khoản mặc định:</strong><br>
            Admin: admin@gmail.com / admin123<br>
            Thủ thư: lib@gmail.com / thu123
        </div>
    </div>
</div>
