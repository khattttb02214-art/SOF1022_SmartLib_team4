@{
    ViewData["Title"] = "Quên mật khẩu"; Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo"><i class="fa fa-key"></i></div>
        <h3 class="auth-title">Quên mật khẩu?</h3>
        <p class="auth-sub">Nhập email đã đăng ký, chúng tôi sẽ gửi mã xác nhận để bạn đặt lại mật khẩu.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 text-sm">
                <i class="fa fa-circle-exclamation me-1"></i>@ViewBag.Error
            </div>
        }

        <form method="post" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-envelope text-muted"></i></span>
                    <input name="email" type="email" class="form-control" placeholder="ban@gmail.com" required autofocus />
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">
                <i class="fa fa-paper-plane me-2"></i>Gửi mã xác nhận
            </button>
        </form>

        <p class="text-center mt-3 text-muted small">
            <a asp-action="Login"><i class="fa fa-arrow-left me-1"></i>Quay lại đăng nhập</a>
        </p>
    </div>
</div>
