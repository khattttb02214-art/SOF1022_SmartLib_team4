@{
    ViewData["Title"] = "Xác minh email Google"; Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .ve-page {
            min-height: 65vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }

        .ve-card {
            background: #fff;
            border: 1.5px solid #e0e7ff;
            border-radius: 28px;
            box-shadow: 0 8px 48px rgba(79,70,229,.16);
            width: 100%;
            max-width: 460px;
            overflow: hidden;
        }

        .ve-card__strip {
            height: 6px;
            background: linear-gradient(90deg,#4f46e5,#7c3aed,#ec4899);
        }

        .ve-card__header {
            text-align: center;
            padding: 36px 32px 20px;
        }

        .ve-icon {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background: linear-gradient(135deg,#ede9fe,#e0e7ff);
            border: 2px solid #c4b5fd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: #7c3aed;
            margin: 0 auto 18px;
        }

        .ve-card__title {
            font-size: 22px;
            font-weight: 800;
            color: #1e1b4b;
            margin: 0 0 8px;
        }

        .ve-card__sub {
            font-size: 13px;
            color: #6b7280;
            line-height: 1.6;
            margin: 0;
            max-width: 320px;
            margin-inline: auto;
        }

        .ve-email-badge {
            display: inline-block;
            background: #ede9fe;
            border: 1.5px solid #c4b5fd;
            border-radius: 100px;
            padding: 6px 18px;
            font-size: 14px;
            font-weight: 700;
            color: #4f46e5;
            margin: 10px 0;
        }

        .ve-google-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fff;
            border: 1.5px solid #dadce0;
            border-radius: 100px;
            padding: 4px 14px;
            font-size: 12px;
            color: #3c4043;
            margin-bottom: 8px;
        }

        .ve-alert {
            margin: 0 28px 8px;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 13px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .ve-alert--success {
            background: #d1fae5;
            border: 1.5px solid #6ee7b7;
            color: #065f46;
        }

        .ve-alert--error {
            background: #fee2e2;
            border: 1.5px solid #fca5a5;
            color: #991b1b;
        }

        .ve-form-body {
            padding: 20px 32px 32px;
        }

        .ve-label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #4338ca;
            margin-bottom: 10px;
            letter-spacing: .4px;
            text-align: center;
        }

        .ve-dots {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .ve-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #e0e7ff;
            transition: all .2s;
        }

            .ve-dot.filled {
                background: #7c3aed;
                transform: scale(1.2);
            }

        .ve-otp-input {
            width: 100%;
            border: 2px solid #e0e7ff;
            border-radius: 16px;
            padding: 18px;
            font-size: 32px;
            font-weight: 800;
            font-family: 'Courier New',monospace;
            text-align: center;
            letter-spacing: 12px;
            color: #1e1b4b;
            background: #faf9ff;
            outline: none;
            box-sizing: border-box;
            margin-bottom: 20px;
            transition: border-color .2s,box-shadow .2s;
        }

            .ve-otp-input:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 4px rgba(124,58,237,.12);
                background: #fff;
            }

            .ve-otp-input::placeholder {
                color: #d1d5db;
                letter-spacing: 8px;
                font-size: 24px;
            }

        .ve-submit-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg,#4f46e5,#7c3aed);
            color: #fff;
            border: none;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 6px 20px rgba(79,70,229,.35);
            transition: transform .15s,box-shadow .15s;
        }

            .ve-submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 30px rgba(79,70,229,.45);
            }

            .ve-submit-btn:disabled {
                opacity: .5;
                cursor: not-allowed;
                transform: none;
            }

        .ve-resend-btn {
            width: 100%;
            padding: 12px;
            border: 1.5px solid #e0e7ff;
            border-radius: 12px;
            background: #faf9ff;
            color: #6b7280;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all .15s;
        }

            .ve-resend-btn:hover {
                border-color: #c4b5fd;
                color: #7c3aed;
                background: #f3f0ff;
            }

        .ve-timer {
            text-align: center;
            font-size: 11px;
            color: #9ca3af;
            margin-top: 14px;
        }

            .ve-timer strong {
                color: #4f46e5;
            }
    </style>
}

<div class="ve-page">
    <div class="ve-card">
        <div class="ve-card__strip"></div>
        <div class="ve-card__header">
            <div class="ve-icon"><i class="fa fa-envelope-circle-check"></i></div>
            <h3 class="ve-card__title">Xác minh email Google</h3>
            <div class="ve-google-badge">
                <svg width="14" height="14" viewBox="0 0 48 48">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
                Tiếp tục với Google
            </div>
            <p class="ve-card__sub">Mã xác minh 6 chữ số đã được gửi đến</p>
            <div class="ve-email-badge"><i class="fa fa-envelope me-1"></i>@(ViewBag.Email ?? "email của bạn")</div>
            <p class="ve-card__sub" style="margin-top:8px;font-size:12px;">Kiểm tra cả thư mục Spam nếu không thấy trong Hộp thư đến.</p>
        </div>

        @if (TempData["GoogleResendSuccess"] != null)
        {
            <div class="ve-alert ve-alert--success"><i class="fa fa-circle-check"></i><span>@TempData["GoogleResendSuccess"]</span></div>
        }
        @if (TempData["GoogleResendError"] != null)
        {
            <div class="ve-alert ve-alert--error"><i class="fa fa-circle-xmark"></i><span>@TempData["GoogleResendError"]</span></div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="ve-alert ve-alert--error"><i class="fa fa-circle-xmark"></i><span>@ViewBag.Error</span></div>
        }

        <div class="ve-form-body">
            <form method="post" asp-action="GoogleVerifyOtp">
                @Html.AntiForgeryToken()
                <label class="ve-label"><i class="fa fa-key me-1"></i> MÃ XÁC MINH (6 CHỮ SỐ)</label>
                <div class="ve-dots" id="veDots">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="ve-dot"></div>
                    }
                </div>
                <input type="text" name="OtpInput" id="veOtpInput" class="ve-otp-input"
                       maxlength="6" placeholder="——————"
                       autofocus autocomplete="one-time-code" inputmode="numeric" />
                <button type="submit" class="ve-submit-btn" id="veSubmitBtn" disabled>
                    <i class="fa fa-check-circle"></i>Xác minh
                </button>
            </form>

            <form method="post" asp-action="GoogleResendOtp">
                @Html.AntiForgeryToken()
                <button type="submit" class="ve-resend-btn">
                    <i class="fa fa-rotate-right"></i>Gửi lại mã xác minh
                </button>
            </form>

            <div class="ve-timer">
                <i class="fa fa-clock" style="color:#7c3aed;margin-right:4px;"></i>
                Mã có hiệu lực trong <strong id="veTimer">10:00</strong>
            </div>

            <div class="text-center mt-3">
                <small><a asp-action="Login">Hủy và quay về đăng nhập</a></small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const inp  = document.getElementById('veOtpInput');
            const dots = document.querySelectorAll('.ve-dot');
            const btn  = document.getElementById('veSubmitBtn');

            function updateState() {
                const val = inp.value.replace(/\D/g, '');
                inp.value = val;
                dots.forEach((d, i) => d.classList.toggle('filled', i < val.length));
                btn.disabled = val.length < 6;
            }

            inp.addEventListener('input', updateState);
            inp.addEventListener('keyup', updateState);
            inp.addEventListener('paste', function () { setTimeout(updateState, 50); });
            updateState();

            let secs = 600;
            (function tick() {
                const m = String(Math.floor(secs / 60)).padStart(2, '0');
                const s = String(secs % 60).padStart(2, '0');
                const el = document.getElementById('veTimer');
                if (el) el.textContent = m + ':' + s;
                if (secs > 0) { secs--; setTimeout(tick, 1000); }
                else if (el) { el.textContent = 'Hết hạn — vui lòng gửi lại'; el.style.color = '#dc2626'; }
            })();
        });
    </script>
}
