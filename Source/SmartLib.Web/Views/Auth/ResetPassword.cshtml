@model string
@{
    ViewData["Title"] = "Đặt lại mật khẩu"; Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo"><i class="fa fa-shield-halved"></i></div>
        <h3 class="auth-title">Đặt lại mật khẩu</h3>
        <p class="auth-sub">Nhập mã xác nhận đã gửi tới <strong>@Model</strong> và mật khẩu mới của bạn.</p>

        @if (TempData["success"] != null)
        {
            <div class="alert alert-success py-2 text-sm">
                <i class="fa fa-circle-check me-1"></i>@TempData["success"]
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 text-sm">
                <i class="fa fa-circle-exclamation me-1"></i>@ViewBag.Error
            </div>
        }

        <form method="post" asp-action="ResetPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@Model" />
            <div class="mb-3">
                <label class="form-label">Mã xác nhận (OTP)</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-hashtag text-muted"></i></span>
                    <input name="otp" type="text" maxlength="6" inputmode="numeric" class="form-control text-center" style="letter-spacing:6px;font-weight:700;" placeholder="123456" required autofocus />
                </div>
                <div class="form-text text-muted">Mã có hiệu lực trong 10 phút.</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock text-muted"></i></span>
                    <input name="matKhauMoi" type="password" class="form-control" placeholder="Ít nhất 6 ký tự" required minlength="6" />
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock text-muted"></i></span>
                    <input name="xacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required minlength="6" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">
                <i class="fa fa-check me-2"></i>Đặt lại mật khẩu
            </button>
        </form>

        <form method="post" asp-action="ForgotPassword" class="text-center mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@Model" />
            <button type="submit" class="btn btn-link btn-sm text-muted">Chưa nhận được mã? Gửi lại</button>
        </form>
    </div>
</div>
