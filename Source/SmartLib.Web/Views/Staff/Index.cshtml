@model SmartLib.Web.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";

    string[] catIcons = { "fa-book", "fa-flask", "fa-briefcase", "fa-landmark", "fa-child", "fa-laptop-code", "fa-palette", "fa-globe" };
    string[] catColors = { "#2a5298", "#198754", "#fd7e14", "#6f42c1", "#d63384", "#0dcaf0", "#20c997", "#ffc107" };
}

<!-- =============== HERO BANNER =============== -->
<!-- Admin/LIB dashboard -->
<div class="home-hero mb-4">
    <div class="home-hero-inner">
        <div class="hero-left">
            <div class="hero-badge">
                <i class="fa fa-star"></i> Hệ thống quản lý thư viện thông minh
            </div>
            <h1 class="hero-title">
                Chào mừng đến với<br />
                <span class="hero-brand">SmartLib</span>
            </h1>
            <p class="hero-sub">
                Quản lý sách, độc giả, mượn trả dễ dàng &mdash; mọi lúc, mọi nơi.
            </p>
            <div class="hero-actions">
                <a asp-controller="Books" asp-action="Index" class="btn btn-hero-primary">
                    <i class="fa fa-book me-2"></i>Quản lý sách
                </a>
                <a asp-controller="Borrow" asp-action="Index" class="btn btn-hero-outline">
                    <i class="fa fa-right-left me-2"></i>Mượn trả
                </a>
            </div>
        </div>
        <div class="hero-right">
            <div class="hero-stats-float">
                <div class="hstat-item">
                    <i class="fa fa-book-open"></i>
                    <div>
                        <div class="hstat-num">@Model.TongSach</div>
                        <div class="hstat-lbl">Đầu sách</div>
                    </div>
                </div>
                <div class="hstat-item">
                    <i class="fa fa-users"></i>
                    <div>
                        <div class="hstat-num">@Model.TongDocGia</div>
                        <div class="hstat-lbl">Độc giả</div>
                    </div>
                </div>
                <div class="hstat-item">
                    <i class="fa fa-right-left"></i>
                    <div>
                        <div class="hstat-num">@Model.SachDangMuon</div>
                        <div class="hstat-lbl">Đang mượn</div>
                    </div>
                </div>
                <div class="hstat-item @(Model.SachQuaHan > 0 ? "danger" : "")">
                    <i class="fa fa-triangle-exclamation"></i>
                    <div>
                        <div class="hstat-num">@Model.SachQuaHan</div>
                        <div class="hstat-lbl">Quá hạn</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =============== TRUY CẬP NHANH =============== -->
<div class="section-card mb-4">
    <div class="section-header">
        <i class="fa fa-bolt"></i>
        <span>Truy cập nhanh</span>
    </div>
    <div class="quick-grid">
        <a asp-controller="Books" asp-action="Index" class="quick-item" style="--qc:#2a5298">
            <div class="quick-icon"><i class="fa fa-book"></i></div>
            <div class="quick-name">Quản lý sách</div>
        </a>
        <a asp-controller="DocGia" asp-action="Index" class="quick-item" style="--qc:#198754">
            <div class="quick-icon"><i class="fa fa-users"></i></div>
            <div class="quick-name">Độc giả</div>
        </a>
        <a asp-controller="Borrow" asp-action="Index" class="quick-item" style="--qc:#fd7e14">
            <div class="quick-icon"><i class="fa fa-right-left"></i></div>
            <div class="quick-name">Mượn / Trả</div>
        </a>
        <a asp-controller="Reservation" asp-action="Index" class="quick-item" style="--qc:#6f42c1">
            <div class="quick-icon"><i class="fa fa-bookmark"></i></div>
            <div class="quick-name">Đặt trước</div>
        </a>
        <a asp-controller="Wishlist" asp-action="Index" class="quick-item" style="--qc:#d63384">
            <div class="quick-icon"><i class="fa fa-heart"></i></div>
            <div class="quick-name">Wishlist</div>
        </a>
        <a asp-controller="Dashboard" asp-action="Index" class="quick-item" style="--qc:#0dcaf0">
            <div class="quick-icon"><i class="fa fa-chart-line"></i></div>
            <div class="quick-name">Dashboard</div>
        </a>
        @if (User.IsInRole("ADMIN"))
        {
            <a asp-controller="Audit" asp-action="Index" class="quick-item" style="--qc:#20c997">
                <div class="quick-icon"><i class="fa fa-clock-rotate-left"></i></div>
                <div class="quick-name">Audit Log</div>
            </a>
        }
        <a asp-controller="DocGia" asp-action="Create" class="quick-item" style="--qc:#e91e63">
            <div class="quick-icon"><i class="fa fa-user-plus"></i></div>
            <div class="quick-name">Thêm độc giả</div>
        </a>
        <a asp-controller="Books" asp-action="Create" class="quick-item" style="--qc:#009688">
            <div class="quick-icon"><i class="fa fa-plus-circle"></i></div>
            <div class="quick-name">Thêm sách</div>
        </a>
        <a asp-controller="Borrow" asp-action="Create" class="quick-item" style="--qc:#ff5722">
            <div class="quick-icon"><i class="fa fa-hand-holding-heart"></i></div>
            <div class="quick-name">Tạo phiếu mượn</div>
        </a>
    </div>
</div>

<!-- =============== ROW: THỂ LOẠI + MƯỢN TRẢ GẦN ĐÂY =============== -->
<div class="row g-4 mb-4">

    <!-- THỂ LOẠI -->
    <div class="col-lg-5">
        <div class="section-card h-100">
            <div class="section-header">
                <i class="fa fa-tags"></i>
                <span>Thể loại sách</span>
                <a asp-controller="Books" asp-action="Index" class="ms-auto view-all">
                    Xem tất cả <i class="fa fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="cat-list">
                @{
                    int ci = 0;
                }
                @foreach (var cat in Model.DanhSachTheLoai)
                {
                    string ico = catIcons[ci % catIcons.Length];
                    string col = catColors[ci % catColors.Length];
                    ci++;
                    <div class="cat-row">
                        <div class="cat-dot" style="background:@col">
                            <i class="fa @ico"></i>
                        </div>
                        <span class="cat-name">@cat.TenTheLoai</span>
                        <span class="cat-count">@cat.SoLuongSach cuốn</span>
                    </div>
                }
                @if (!Model.DanhSachTheLoai.Any())
                {
                    <div class="empty-state">
                        <i class="fa fa-folder-open fa-2x mb-2"></i>
                        <div>Chưa có thể loại nào</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- MƯỢN TRẢ GẦN ĐÂY -->
    <div class="col-lg-7">
        <div class="section-card h-100">
            <div class="section-header">
                <i class="fa fa-clock-rotate-left"></i>
                <span>Phiếu mượn gần đây</span>
                <a asp-controller="Borrow" asp-action="Index" class="ms-auto view-all">
                    Xem tất cả <i class="fa fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table home-table mb-0">
                    <thead>
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Độc giả</th>
                            <th>Ngày mượn</th>
                            <th>Hạn trả</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MuonTraGanDay)
                        {
                            bool overdue = m.TrangThai == "Đang Mượn" && m.NgayHenTra < DateTime.Now;
                            <tr>
                                <td><span class="code-badge">@m.MaPhieu</span></td>
                                <td><i class="fa fa-user-circle me-1 text-muted"></i>@m.TenDocGia</td>
                                <td>@($"{m.NgayMuon:dd/MM/yyyy}")</td>
                                <td class="@(overdue ? "text-danger fw-semibold" : "")">
                                    @($"{m.NgayHenTra:dd/MM/yyyy}")
                                    @if (overdue)
                                    {
                                        <i class="fa fa-triangle-exclamation ms-1"></i>
                                    }
                                </td>
                                <td>
                                    @{
                                        string badgeClass = m.TrangThai switch
                                        {
                                            "Đã Trả" => "status-badge returned",
                                            "Đang Mượn" when overdue => "status-badge overdue",
                                            "Đang Mượn" => "status-badge borrowing",
                                            _ => "status-badge"
                                        };
                                    }
                                    <span class="@badgeClass">@m.TrangThai</span>
                                </td>
                            </tr>
                        }
                        @if (!Model.MuonTraGanDay.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="fa fa-inbox fa-2x d-block mb-2"></i>Chưa có phiếu mượn nào
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- =============== SÁCH MỚI NHẬP =============== -->
<div class="section-card mb-4">
    <div class="section-header">
        <i class="fa fa-sparkles"></i>
        <span>Sách mới nhập</span>
        <a asp-controller="Books" asp-action="Index" class="ms-auto view-all">
            Xem tất cả <i class="fa fa-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="books-grid">
        @foreach (var sach in Model.SachMoiNhat)
        {
            <div class="book-item animate-book">
                <div class="book-cover-wrap">
                    @if (!string.IsNullOrEmpty(sach.AnhBia))
                    {
                        <img src="~/uploads/books/@sach.AnhBia" alt="@sach.TenSach" class="book-cover-img" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">
                            <i class="fa fa-book fa-2x"></i>
                        </div>
                    }
                    <div class="book-avail @(sach.SoLuongKhaDung > 0 ? "avail" : "unavail")">
                        @(sach.SoLuongKhaDung > 0 ? "Còn sách" : "Hết sách")
                    </div>
                </div>
                <div class="book-info">
                    <div class="book-cat">@(sach.TenTheLoai ?? "Chưa phân loại")</div>
                    <div class="book-title-text" title="@sach.TenSach">@sach.TenSach</div>
                    <div class="book-qty">
                        <i class="fa fa-cubes me-1"></i>Còn @sach.SoLuongKhaDung cuốn
                    </div>
                </div>
            </div>
        }
        @if (!Model.SachMoiNhat.Any())
        {
            <div class="empty-state w-100 py-4">
                <i class="fa fa-book-open fa-2x mb-2"></i>
                <div>Chưa có sách nào trong hệ thống</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <style>
       

        /* === ENTRANCE ANIMATIONS === */
        .home-hero { animation: heroIn 0.5s ease-out; }
        @@keyframes heroIn { from { opacity:0; transform:translateY(-15px); } to { opacity:1; transform:translateY(0); } }
        
        .section-card { animation: cardIn 0.5s ease-out both; }
        .section-card:nth-child(1) { animation-delay: 0.05s; }
        .section-card:nth-child(2) { animation-delay: 0.10s; }
        .section-card:nth-child(3) { animation-delay: 0.15s; }
        @@keyframes cardIn { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
        
        .animate-book { animation: bookIn 0.4s ease-out both; }
        .books-grid .book-item:nth-child(1) { animation-delay: 0.00s; }
        .books-grid .book-item:nth-child(2) { animation-delay: 0.07s; }
        .books-grid .book-item:nth-child(3) { animation-delay: 0.14s; }
        .books-grid .book-item:nth-child(4) { animation-delay: 0.21s; }
        .books-grid .book-item:nth-child(5) { animation-delay: 0.28s; }
        .books-grid .book-item:nth-child(6) { animation-delay: 0.35s; }
        @@keyframes bookIn { from { opacity:0; transform:scale(0.88) translateY(12px); } to { opacity:1; transform:scale(1) translateY(0); } }
        
        .hstat-item { animation: statIn 0.4s ease-out both; }
        .hstat-item:nth-child(1) { animation-delay: 0.1s; }
        .hstat-item:nth-child(2) { animation-delay: 0.2s; }
        .hstat-item:nth-child(3) { animation-delay: 0.3s; }
        .hstat-item:nth-child(4) { animation-delay: 0.4s; }
        @@keyframes statIn { from { opacity:0; transform:scale(0.85); } to { opacity:1; transform:scale(1); } }

        /* === BOOK SHIMMER EFFECT === */
        .book-cover-wrap::after {
            content: '';
            position: absolute; inset: 0;
            background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.25) 50%, transparent 70%);
            border-radius: 12px;
            opacity: 0;
            transition: opacity .3s;
            pointer-events: none;
        }
        .book-item:hover .book-cover-wrap::after { opacity: 1; }
        
                .home-hero {
            background: linear-gradient(135deg,#1e3c72 0%,#2a5298 60%,#3a6bc7 100%);
            border-radius: 22px;
            padding: 36px 36px;
            color: white;
            overflow: hidden;
            position: relative;
        }
        .home-hero::before {
            content: '';
            position: absolute;
            top: -40px; right: -40px;
            width: 280px; height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }
        .home-hero::after {
            content: '';
            position: absolute;
            bottom: -60px; right: 120px;
            width: 180px; height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
        }
        .home-hero-inner {
            display: flex;
            align-items: center;
            gap: 32px;
            position: relative;
            z-index: 1;
        }
        .hero-left { flex: 1; }
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 12px;
            margin-bottom: 14px;
            letter-spacing: 0.3px;
        }
        .hero-title {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.25;
            margin-bottom: 10px;
        }
        .hero-brand {
            color: #7dd3fc;
            font-style: italic;
        }
        .hero-sub {
            font-size: 15px;
            opacity: 0.85;
            margin-bottom: 22px;
        }
        .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
        .btn-hero-primary {
            background: white;
            color: #1e3c72;
            border: none;
            border-radius: 12px;
            padding: 10px 22px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            transition: all .2s;
        }
        .btn-hero-primary:hover {
            background: #f0f7ff;
            transform: translateY(-2px);
            color: #1e3c72;
        }
        .btn-hero-outline {
            background: transparent;
            color: white;
            border: 1.5px solid rgba(255,255,255,0.6);
            border-radius: 12px;
            padding: 10px 22px;
            font-size: 14px;
            text-decoration: none;
            transition: all .2s;
        }
        .btn-hero-outline:hover {
            background: rgba(255,255,255,0.12);
            color: white;
            border-color: white;
        }
        .hero-right { flex-shrink: 0; }
        .hero-stats-float {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            width: 280px;
        }
        .hstat-item {
            background: rgba(255,255,255,0.12);
            border-radius: 16px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(4px);
            transition: .2s;
        }
        .hstat-item:hover { background: rgba(255,255,255,0.2); }
        .hstat-item.danger { background: rgba(220,53,69,0.3); }
        .hstat-item i {
            font-size: 20px;
            opacity: 0.9;
            width: 24px;
            text-align: center;
        }
        .hstat-num { font-size: 22px; font-weight: 700; line-height: 1; }
        .hstat-lbl { font-size: 11px; opacity: 0.75; margin-top: 2px; }

        /* Section card */
        .section-card {
            background: white;
            border-radius: 18px;
            padding: 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            overflow: hidden;
        }
        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 16px 20px;
            border-bottom: 1px solid #f0f0f0;
            font-weight: 600;
            font-size: 15px;
            color: #1e3c72;
        }
        .section-header i {
            color: #2a5298;
            font-size: 16px;
        }
        .view-all {
            font-size: 12px;
            color: #2a5298;
            text-decoration: none;
            font-weight: 500;
        }
        .view-all:hover { color: #1e3c72; }

        /* Quick access */
        .quick-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            padding: 18px 20px;
        }
        .quick-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            width: 90px;
            transition: transform .2s;
        }
        .quick-item:hover { transform: translateY(-4px); }
        .quick-icon {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            background: color-mix(in srgb, var(--qc) 12%, white);
            color: var(--qc);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: background .2s;
        }
        .quick-item:hover .quick-icon {
            background: color-mix(in srgb, var(--qc) 20%, white);
        }
        .quick-name {
            font-size: 12px;
            color: #444;
            font-weight: 500;
            text-align: center;
            line-height: 1.3;
        }

        /* Category list */
        .cat-list { padding: 8px 0; }
        .cat-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 20px;
            transition: background .15s;
        }
        .cat-row:hover { background: #f8f9ff; }
        .cat-dot {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
            flex-shrink: 0;
        }
        .cat-name { flex: 1; font-size: 14px; font-weight: 500; color: #333; }
        .cat-count {
            font-size: 12px;
            background: #f0f4ff;
            color: #2a5298;
            padding: 3px 10px;
            border-radius: 20px;
            font-weight: 600;
            flex-shrink: 0;
        }

        /* Home table */
        .home-table {
            font-size: 13.5px;
        }
        .home-table thead th {
            background: #f8f9fc;
            color: #666;
            font-weight: 600;
            border-bottom: 1px solid #eee;
            padding: 10px 14px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .home-table tbody td {
            padding: 11px 14px;
            border-bottom: 1px solid #f5f5f5;
            vertical-align: middle;
        }
        .home-table tbody tr:last-child td { border-bottom: none; }
        .home-table tbody tr:hover td { background: #f8f9ff; }
        .code-badge {
            background: #f0f4ff;
            color: #2a5298;
            border-radius: 8px;
            padding: 3px 9px;
            font-family: monospace;
            font-size: 12px;
            font-weight: 600;
        }
        .status-badge {
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-badge.returned { background: #d1fae5; color: #065f46; }
        .status-badge.borrowing { background: #dbeafe; color: #1e40af; }
        .status-badge.overdue { background: #fee2e2; color: #991b1b; }

        /* Books grid */
        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 16px;
            padding: 18px 20px;
        }
        .book-item { cursor: pointer; }
        .book-item:hover .book-cover-wrap { transform: translateY(-4px); }
        .book-cover-wrap {
            position: relative;
            transition: transform .2s;
        }
        .book-cover-img {
            width: 100%;
            height: 170px;
            object-fit: cover;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        }
        .book-cover-placeholder {
            width: 100%;
            height: 170px;
            border-radius: 12px;
            background: linear-gradient(135deg,#e8edf8,#c7d4f0);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2a5298;
            opacity: 0.7;
        }
        .book-avail {
            position: absolute;
            top: 8px; right: 8px;
            border-radius: 8px;
            font-size: 10px;
            font-weight: 700;
            padding: 3px 8px;
        }
        .book-avail.avail { background: #d1fae5; color: #065f46; }
        .book-avail.unavail { background: #fee2e2; color: #991b1b; }
        .book-info { padding-top: 10px; }
        .book-cat {
            font-size: 11px;
            color: #2a5298;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin-bottom: 3px;
        }
        .book-title-text {
            font-size: 13px;
            font-weight: 600;
            color: #222;
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .book-qty {
            font-size: 12px;
            color: #888;
            margin-top: 4px;
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            color: #aaa;
            padding: 24px 0;
        }

        /* Dark mode */
        body.dark-mode .section-card {
            background: #1e1e1e !important;
            color: white !important;
        }
        body.dark-mode .section-header { color: #90b4e8 !important; border-color: #333 !important; }
        body.dark-mode .cat-row:hover { background: #2a2a2a !important; }
        body.dark-mode .cat-name { color: #eee !important; }
