@{
	ViewData["Title"] = "Dashboard Thủ Thư";
}

@section Styles {
	<style>
		/* ────── STAFF DASHBOARD TOKENS ────── */
		:root {
			--staff-blue:    #0369a1;
			--staff-blue2:   #0284c7;
			--staff-cyan:    #0891b2;
			--staff-teal:    #0d9488;
			--staff-orange:  #ea580c;
			--staff-red:     #dc2626;
			--staff-light:   #f0f9ff;
			--staff-white:   #ffffff;
			--staff-text:    #0c2340;
			--staff-border:  #bae6fd;
			--staff-radius:  14px;
			--staff-radius2: 20px;
			--staff-shadow:  0 4px 24px rgba(3,105,161,.12);
			--staff-shadow2: 0 8px 40px rgba(3,105,161,.18);
		}

		/* ────── PAGE WRAPPER ────── */
		.staff-page {
			background: linear-gradient(135deg, #ecf0f1 0%, #f8fbff 100%);
			min-height: 100vh;
			font-family: 'Segoe UI', 'Inter', sans-serif;
			padding: 0 0 48px;
		}

		/* ────── WELCOME BANNER ────── */
		.staff-banner {
			background: linear-gradient(135deg, #003d7a 0%, #0369a1 45%, #0891b2 100%);
			border-radius: 0 0 32px 32px;
			padding: 40px 32px 72px;
			position: relative;
			overflow: hidden;
			margin-bottom: -40px;
		}
		.staff-banner::before {
			content: '';
			position: absolute;
			width: 400px; height: 400px;
			background: radial-gradient(circle, rgba(2,196,199,.2) 0%, transparent 70%);
			top: -100px; right: -80px;
			border-radius: 50%;
		}
		.staff-banner::after {
			content: '';
			position: absolute;
			width: 250px; height: 250px;
			background: radial-gradient(circle, rgba(234,88,12,.15) 0%, transparent 70%);
			bottom: 10px; left: 15%;
			border-radius: 50%;
		}
		.staff-banner__inner { position: relative; z-index: 2; }
		.staff-banner__greeting {
			font-size: 12px;
			font-weight: 700;
			color: rgba(165,243,252,.9);
			letter-spacing: 1.3px;
			text-transform: uppercase;
			margin-bottom: 8px;
		}
		.staff-banner__title {
			font-size: 32px;
			font-weight: 900;
			color: #ffffff;
			margin: 0 0 20px;
		}
		.staff-banner__subtitle {
			font-size: 14px;
			color: rgba(206,235,245,.8);
			margin-bottom: 24px;
		}

		/* ────── STAT PILLS ────── */
		.staff-stats {
			display: flex;
			gap: 14px;
			flex-wrap: wrap;
			align-items: center;
		}
		.staff-stat {
			background: rgba(255,255,255,.13);
			backdrop-filter: blur(10px);
			border: 1px solid rgba(255,255,255,.2);
			border-radius: 14px;
			padding: 14px 22px;
			display: flex;
			align-items: center;
			gap: 13px;
			min-width: 145px;
			transition: all .25s;
		}
		.staff-stat:hover {
			transform: translateY(-2px);
			background: rgba(255,255,255,.18);
			box-shadow: 0 8px 16px rgba(0,0,0,.2);
		}
		.staff-stat__icon {
			width: 44px; height: 44px;
			border-radius: 11px;
			display: flex; align-items: center; justify-content: center;
			font-size: 20px;
			flex-shrink: 0;
		}
		.staff-stat__icon--cyan   { background: rgba(6,182,212,.3); color: #22d3ee; }
		.staff-stat__icon--orange { background: rgba(234,88,12,.3); color: #fdba74; }
		.staff-stat__icon--red    { background: rgba(220,38,38,.3); color: #fca5a5; }
		.staff-stat__icon--teal   { background: rgba(13,148,136,.3); color: #7ee8c9; }
		.staff-stat__num  { font-size: 24px; font-weight: 900; color: #ffffff; line-height: 1; }
		.staff-stat__lbl  { font-size: 11px; color: rgba(206,235,245,.85); margin-top: 3px; font-weight: 600; }

		/* ────── CONTENT AREA ────── */
		.staff-content {
			padding: 0 28px;
			max-width: 1400px;
			margin: 0 auto;
		}

		/* ────── QUICK ACTION CARDS ────── */
		.staff-actions-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 16px;
			margin-bottom: 32px;
		}
		.staff-action-card {
			background: var(--staff-white);
			border: 1.5px solid var(--staff-border);
			border-radius: var(--staff-radius2);
			padding: 24px 20px;
			text-align: center;
			text-decoration: none;
			color: inherit;
			transition: all .25s;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 12px;
		}
		.staff-action-card:hover {
			transform: translateY(-4px);
			box-shadow: var(--staff-shadow2);
			border-color: var(--staff-blue2);
		}
		.staff-action-card__icon {
			width: 50px; height: 50px;
			border-radius: 12px;
			display: flex; align-items: center; justify-content: center;
			font-size: 24px;
			background: linear-gradient(135deg, #e0f2fe, #cffafe);
			color: var(--staff-blue);
		}
		.staff-action-card__title {
			font-size: 14px;
			font-weight: 700;
			color: var(--staff-text);
		}
		.staff-action-card__desc {
			font-size: 11px;
			color: #64748b;
		}

		/* ────── SECTION HEADER ────── */
		.staff-sec-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 20px;
			margin-top: 32px;
		}
		.staff-sec-title {
			font-size: 18px;
			font-weight: 800;
			color: var(--staff-text);
			display: flex;
			align-items: center;
			gap: 10px;
			margin: 0;
		}
		.staff-sec-title__icon {
			width: 36px; height: 36px;
			border-radius: 10px;
			display: flex; align-items: center; justify-content: center;
			font-size: 16px;
			background: linear-gradient(135deg, #e0f2fe, #cffafe);
			color: var(--staff-blue);
		}

		/* ────── DATA CARD ────── */
		.staff-data-card {
			background: var(--staff-white);
			border: 1.5px solid var(--staff-border);
			border-radius: var(--staff-radius2);
			overflow: hidden;
			box-shadow: var(--staff-shadow);
			margin-bottom: 28px;
		}
		.staff-data-card__header {
			background: linear-gradient(90deg, #e0f2fe 0%, #cffafe 100%);
			padding: 16px 20px;
			border-bottom: 1.5px solid #bae6fd;
			display: flex;
			align-items: center;
			gap: 12px;
		}
		.staff-data-card__header-icon {
			width: 36px; height: 36px;
			background: var(--staff-blue);
			border-radius: 9px;
			display: flex; align-items: center; justify-content: center;
			color: #fff; font-size: 16px;
		}
		.staff-data-card__header-text {
			font-size: 14px;
			font-weight: 700;
			color: var(--staff-text);
		}

		/* ────── TABLE STYLES ────── */
		.staff-table {
			width: 100%;
			border-collapse: collapse;
		}
		.staff-table thead th {
			padding: 14px 16px;
			font-size: 11px;
			font-weight: 800;
			color: var(--staff-text);
			text-transform: uppercase;
			letter-spacing: .8px;
			background: #f0f9ff;
			border-bottom: 2px solid var(--staff-border);
			text-align: left;
		}
		.staff-table tbody td {
			padding: 13px 16px;
			font-size: 13px;
			color: #374151;
			border-bottom: 1px solid #e5e7eb;
			vertical-align: middle;
		}
		.staff-table tbody tr:last-child td { border-bottom: none; }
		.staff-table tbody tr:hover td { background: #f8fbff; }

		/* ────── BADGE STYLES ────── */
		.staff-badge {
			display: inline-flex;
			align-items: center;
			gap: 5px;
			padding: 5px 12px;
			border-radius: 100px;
			font-size: 11px;
			font-weight: 700;
			white-space: nowrap;
		}
		.staff-badge--blue   { background: #dbeafe; color: #0369a1; }
		.staff-badge--green  { background: #dcfce7; color: #166534; }
		.staff-badge--red    { background: #fee2e2; color: #991b1b; }
		.staff-badge--orange { background: #fed7aa; color: #9a3412; }

		/* ────── BUTTON STYLES ────── */
		.staff-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 6px;
			padding: 8px 14px;
			border-radius: 8px;
			border: none;
			font-size: 12px;
			font-weight: 600;
			font-family: inherit;
			cursor: pointer;
			transition: all .15s;
			text-decoration: none;
		}
		.staff-btn--primary {
			background: linear-gradient(135deg, var(--staff-blue) 0%, var(--staff-cyan) 100%);
			color: #fff;
			box-shadow: 0 4px 12px rgba(3,105,161,.3);
		}
		.staff-btn--primary:hover {
			transform: translateY(-1px);
			box-shadow: 0 6px 16px rgba(3,105,161,.4);
		}
		.staff-btn--outline {
			border: 1.5px solid var(--staff-border);
			background: transparent;
			color: var(--staff-blue);
		}
		.staff-btn--outline:hover {
			background: #f0f9ff;
			border-color: var(--staff-blue2);
		}

		/* ────── RESPONSIVE ────── */
		@@media (max-width: 768px) {
			.staff-content { padding: 0 16px; }
			.staff-banner { padding: 28px 20px 52px; }
			.staff-banner__title { font-size: 24px; }
			.staff-stats { gap: 10px; }
			.staff-stat { min-width: 120px; padding: 10px 14px; }
			.staff-actions-grid { grid-template-columns: repeat(2, 1fr); }
		}
		@@media (max-width: 480px) {
			.staff-banner__title { font-size: 20px; }
			.staff-stats { gap: 8px; flex-direction: column; align-items: stretch; }
			.staff-stat { min-width: unset; }
			.staff-actions-grid { grid-template-columns: 1fr; }
		}
	</style>
}

