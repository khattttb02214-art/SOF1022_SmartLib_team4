@model List<SmartLib.Web.Models.DocGia>
@{ ViewData["Title"] = "Quản lý độc giả"; }

<div class="page-header-card d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h4 class="mb-0"><i class="fa fa-users me-2"></i>Quản lý độc giả</h4>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="DownloadTemplate" class="btn btn-outline-success btn-sm"><i class="fa fa-file-excel me-1"></i>Tải template</a>
        <button class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#importModal"><i class="fa fa-file-import me-1"></i>Import Excel</button>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa fa-user-plus me-1"></i>Thêm độc giả</a>
    </div>
</div>

<div class="card shadow-sm mb-3 border-0"><div class="card-body py-2">
    <form method="get" class="d-flex gap-2 flex-wrap">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="max-width:300px" placeholder="Tìm tên, email..." />
        <button class="btn btn-primary"><i class="fa fa-search me-1"></i>Tìm</button>
    </form>
</div></div>

<div class="card shadow-sm border-0"><div class="card-body p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="dgTable">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Độc giả</th>
                    <th>Lớp / Khoa</th>
                    <th>Liên hệ</th>
                    <th>Thẻ TV</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(d.AnhDaiDien))
                                {
                                { <img src="/uploads/readers/@d.AnhDaiDien" width="38" height="38" class="rounded-circle" style="object-fit:cover;border:2px solid #e8edf8" /> }
                                }
                                else
                                { <div style="width:38px;height:38px;border-radius:50%;background:var(--bs-primary-bg-subtle);display:grid;place-items:center"><i class="fa fa-user text-primary"></i></div> }
                                <div>
                                    <div class="fw-semibold">@d.HoTen</div>
                                    <small class="text-muted font-monospace">@d.MaDocGia</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(d.Lop)){ <div><small>@d.Lop</small></div> }
                            @if (!string.IsNullOrEmpty(d.Khoa)){ <div><small class="text-muted">@d.Khoa</small></div> }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(d.Email)){ <div><small><i class="fa fa-envelope fa-xs me-1 text-muted"></i>@d.Email</small></div> }
                            @if (!string.IsNullOrEmpty(d.SoDienThoai)){ <div><small><i class="fa fa-phone fa-xs me-1 text-muted"></i>@d.SoDienThoai</small></div> }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(d.MaTheTV))
                            {
                            { <span class="badge bg-primary-subtle text-primary font-monospace">@d.MaTheTV</span> }
                            }
                            else
                            { <span class="text-muted small">Chưa có thẻ</span> }
                        </td>
                        <td class="text-center">
                            @if (!d.DaDuyet)
                            {
                            { <span class="badge bg-warning-subtle text-warning"><i class="fa fa-clock me-1"></i>Chờ duyệt</span> }
                            }
                            else if (d.TrangThaiThe)
                            { <span class="badge bg-success-subtle text-success"><i class="fa fa-check me-1"></i>Hoạt động</span> }
                            else
                            { <span class="badge bg-secondary-subtle text-secondary"><i class="fa fa-ban me-1"></i>Khóa thẻ</span> }
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">
                                <a asp-action="Edit" asp-route-id="@d.MaDocGia" class="btn btn-xs btn-outline-primary" title="Sửa"><i class="fa fa-pen"></i></a>
                                <button onclick="confirmToggle('@d.MaDocGia','@d.HoTen',@(d.TrangThaiThe ? "true" : "false"))" class="btn btn-xs @(d.TrangThaiThe ? "btn-outline-warning" : "btn-outline-success")" title="@(d.TrangThaiThe ? "Khóa thẻ" : "Mở thẻ")">
                                    <i class="fa @(d.TrangThaiThe ? "fa-lock" : "fa-lock-open")"></i>
                                </button>
                                <button onclick="confirmDelete('@d.MaDocGia','@d.HoTen')" class="btn btn-xs btn-outline-danger" title="Xóa"><i class="fa fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div></div>

@* Import Modal *@
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title"><i class="fa fa-file-import me-2 text-info"></i>Import độc giả từ Excel</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="alert alert-info">
                    <strong><i class="fa fa-circle-info me-1"></i>Hướng dẫn:</strong>
                    <ul class="mb-0 mt-1 small">
                        <li>Cột bắt buộc: <strong>Họ tên</strong></li>
                        <li>Các cột khác: Email, SĐT, Lớp, Khoa, Ngày sinh, Mật khẩu</li>
                        <li>Nếu để trống mật khẩu → mặc định: <code>smartlib@123</code></li>
                        <li>Tài khoản được tạo tự động nếu có Email</li>
                    </ul>
                    <a asp-action="DownloadTemplate" class="btn btn-sm btn-outline-success mt-2">
                        <i class="fa fa-download me-1"></i>Tải file mẫu Excel
                    </a>
                </div>
                <div class="mb-3">
                    <label class="form-label req">Chọn file Excel (.xlsx)</label>
                    <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-info text-white"><i class="fa fa-upload me-1"></i>Import</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
$("#dgTable").DataTable({pageLength:25,order:[[0,"asc"]],language:{search:"Tìm:",info:"_START_–_END_ / _TOTAL_",paginate:{next:"›",previous:"‹"}}});

function confirmToggle(id, ten, active) {
    const action = active === true || active === 'true' ? 'khóa' : 'mở';
    Swal.fire({title:`${action.charAt(0).toUpperCase()+action.slice(1)} thẻ?`,text:`Bạn muốn ${action} thẻ của ${ten}?`,icon:'question',showCancelButton:true,confirmButtonColor:active?'#f0a500':'#198754',cancelButtonText:'Hủy',confirmButtonText:`${action.charAt(0).toUpperCase()+action.slice(1)} thẻ`})
        .then(r=>{if(r.isConfirmed)window.location.href=`/DocGia/ToggleCard/${id}`;});
}
function confirmDelete(id, ten) {
    Swal.fire({title:'Xóa độc giả?',text:`Xóa ${ten} khỏi hệ thống?`,icon:'warning',showCancelButton:true,confirmButtonColor:'#d33',cancelButtonText:'Hủy',confirmButtonText:'Xóa'})
        .then(r=>{if(r.isConfirmed)window.location.href=`/DocGia/Delete/${id}`;});
}
</script>
}
