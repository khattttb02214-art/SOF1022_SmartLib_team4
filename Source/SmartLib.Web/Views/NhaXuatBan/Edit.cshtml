@model SmartLib.Web.ViewModels.NhaXuatBanViewModel
@{ ViewData["Title"] = "Sửa NXB"; }
<div class="page-header-card"><h4><i class="fa fa-pen me-2"></i>Sửa nhà xuất bản</h4></div>
<form asp-action="Edit" asp-route-id="@Model.MaNXB" method="post">@Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-7"><div class="form-card"><div class="row g-3">
            <div class="col-md-4"><label class="form-label">Mã NXB</label><input asp-for="MaNXB" class="form-control bg-light" readonly /></div>
            <div class="col-md-8"><label class="form-label req">Tên NXB</label><input asp-for="TenNXB" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">SĐT</label><input asp-for="SoDienThoai" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" /></div>
            <div class="col-12"><label class="form-label">Địa chỉ</label><input asp-for="DiaChi" class="form-control" /></div>
        </div></div></div>
        <div class="col-lg-5"><div class="form-card d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-save me-2"></i>Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div></div>
    </div>
</form>
