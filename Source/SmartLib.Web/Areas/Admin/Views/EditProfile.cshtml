@model SmartLib.Web.Models.NhanVien
@{
	ViewData["Title"] = "Thông tin cá nhân";
}

@section Styles {
	<style>
		:root {
			--admin-indigo: #4f46e5;
			--admin-violet: #7c3aed;
			--admin-pink: #ec4899;
			--admin-border: #e0e7ff;
			--admin-bg: #f4f3ff;
		}

		.admin-page {
			padding: 0 4px 60px;
		}

		/* PAGE HEADER */
		.admin-page-header {
			background: linear-gradient(135deg, #312e81 0%, #4338ca 50%, #6d28d9 100%);
			border-radius: 20px;
			padding: 26px 28px;
			margin-bottom: 28px;
			display: flex;
			align-items: center;
			gap: 16px;
			position: relative;
			overflow: hidden;
		}

		.admin-page-header::before {
			content: '';
			position: absolute;
			width: 200px; height: 200px;
			border-radius: 50%;
			background: radial-gradient(circle, rgba(167,139,250,.25) 0%, transparent 70%);
			top: -60px; right: -30px;
			pointer-events: none;
		}

		.admin-page-header__icon {
			width: 52px; height: 52px;
			border-radius: 14px;
			background: rgba(255,255,255,.15);
			border: 1.5px solid rgba(255,255,255,.25);
			display: flex; align-items: center; justify-content: center;
			font-size: 22px;
			color: #c4b5fd;
			flex-shrink: 0;
			position: relative; z-index: 1;
		}

		.admin-page-header__text {
			position: relative; z-index: 1;
		}

		.admin-page-header h4 {
			color: #fff;
			font-size: 20px; font-weight: 800;
			margin: 0 0 4px;
		}

		.admin-page-header p {
			color: rgba(196,181,253,.75);
			font-size: 13px;
			margin: 0;
		}

		/* LAYOUT */
		.admin-row {
			display: flex;
			gap: 24px;
		}

		.admin-col-left {
			width: 300px;
			flex-shrink: 0;
		}

		.admin-col-right {
			flex: 1;
			min-width: 0;
		}

		/* PROFILE CARD (left) */
		.admin-card {
			background: #fff;
			border: 1.5px solid var(--admin-border);
			border-radius: 20px;
			box-shadow: 0 4px 24px rgba(79,70,229,.09);
			padding: 28px 20px;
			text-align: center;
			position: sticky;
			top: 80px;
		}

		.admin-avatar-ring {
			width: 96px; height: 96px;
			border-radius: 50%;
			margin: 0 auto 16px;
			position: relative;
			background: linear-gradient(135deg, #4f46e5, #ec4899);
			padding: 3px;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.admin-avatar-ring img {
			width: 90px; height: 90px;
			border-radius: 50%;
			object-fit: cover;
			border: 3px solid #fff;
		}

		.admin-avatar-initials {
			width: 90px; height: 90px;
			border-radius: 50%;
			background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
			display: flex; align-items: center; justify-content: center;
			font-size: 36px; font-weight: 800;
			color: #fff;
			border: 3px solid #fff;
		}

		.admin-name {
			font-size: 17px;
			font-weight: 800;
			color: #1e1b4b;
			margin: 0 0 4px;
		}

		.admin-email {
			font-size: 12px;
			color: #6b7280;
			margin: 0 0 10px;
		}

		.admin-meta {
			font-size: 12px;
			color: #6b7280;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 6px;
			margin-bottom: 14px;
		}

		.admin-status {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 6px 16px;
			border-radius: 100px;
			font-size: 12px;
			font-weight: 700;
			background: #d1fae5;
			color: #065f46;
		}

		/* INFO ITEMS */
		.admin-info-items {
			margin-top: 20px;
			border-top: 1.5px solid var(--admin-border);
			padding-top: 18px;
		}

		.admin-info-item {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 8px 0;
			border-bottom: 1px solid #f9f8ff;
			text-align: left;
		}

		.admin-info-item:last-child {
			border-bottom: none;
		}

		.admin-info-item__icon {
			width: 28px; height: 28px;
			border-radius: 8px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 12px;
			flex-shrink: 0;
			background: #ede9fe;
			color: #7c3aed;
		}

		.admin-info-item__label {
			font-size: 11px;
			color: #9ca3af;
		}

		.admin-info-item__value {
			font-size: 13px;
			font-weight: 600;
			color: #1e1b4b;
		}

		/* FORM CARD (right) */
		.admin-form-card {
			background: #fff;
			border: 1.5px solid var(--admin-border);
			border-radius: 20px;
			box-shadow: 0 4px 24px rgba(79,70,229,.09);
			overflow: hidden;
		}

		.admin-form-card__header {
			padding: 20px 26px;
			background: linear-gradient(90deg, #faf5ff 0%, #f3f0ff 100%);
			border-bottom: 1.5px solid #ede9fe;
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.admin-form-card__header-icon {
			width: 36px; height: 36px;
			border-radius: 10px;
			background: linear-gradient(135deg, #4f46e5, #7c3aed);
			display: flex;
			align-items: center;
			justify-content: center;
			color: #fff;
			font-size: 14px;
		}

		.admin-form-card__header-text {
			font-size: 15px;
			font-weight: 700;
			color: #1e1b4b;
		}

		.admin-form-card__header-sub {
			font-size: 12px;
			color: #7c3aed;
			margin-top: 1px;
		}

		.admin-form-body {
			padding: 26px;
		}

		/* OTP NOTICE */
		.admin-otp-notice {
			background: linear-gradient(90deg, #ede9fe 0%, #e0e7ff 100%);
			border: 1.5px solid #c4b5fd;
			border-radius: 12px;
			padding: 12px 16px;
			display: flex;
			align-items: flex-start;
			gap: 10px;
			margin-bottom: 24px;
		}

		.admin-otp-notice__icon {
			width: 20px; height: 20px;
			flex-shrink: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 12px;
			color: #7c3aed;
			margin-top: 2px;
		}

		.admin-otp-notice__text {
			font-size: 13px;
			color: #1e1b4b;
			line-height: 1.5;
		}

		.admin-otp-notice__text strong {
			color: #7c3aed;
			font-weight: 700;
		}

		/* FORM ELEMENTS */
		.admin-form-group {
			margin-bottom: 22px;
		}

		.admin-label {
			display: block;
			font-size: 13px;
			font-weight: 700;
			color: #1e1b4b;
			margin-bottom: 8px;
		}

		.admin-input {
			width: 100%;
			border: 1.5px solid var(--admin-border);
			border-radius: 12px;
			padding: 11px 14px;
			font-size: 14px;
			font-family: inherit;
			color: #1e1b4b;
			background: #fff;
			outline: none;
			transition: all .2s;
		}

		.admin-input:focus {
			border-color: #7c3aed;
			box-shadow: 0 0 0 3px rgba(124,58,237,.12);
			background: #fefbff;
		}

		.admin-input:disabled {
			background: #f0edff;
			color: #6b7280;
			cursor: not-allowed;
		}

		.admin-form-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 16px;
		}

		.admin-file-input {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			padding: 24px;
			border: 2px dashed var(--admin-border);
			border-radius: 14px;
			background: var(--admin-bg);
			cursor: pointer;
			transition: all .2s;
			text-decoration: none;
			color: #4f46e5;
		}

		.admin-file-input:hover {
			border-color: #7c3aed;
			background: #ede9fe;
		}

		.admin-submit-btn {
			width: 100%;
			padding: 12px 20px;
			background: linear-gradient(135deg, var(--admin-indigo) 0%, var(--admin-violet) 100%);
			color: #fff;
			border: none;
			border-radius: 12px;
			font-size: 14px;
			font-weight: 700;
			font-family: inherit;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			transition: all .15s;
			box-shadow: 0 4px 12px rgba(79,70,229,.3);
			margin-top: 8px;
		}

		.admin-submit-btn:hover {
			transform: translateY(-1px);
			box-shadow: 0 6px 16px rgba(79,70,229,.4);
		}

		/* RESPONSIVE */
		@@media (max-width: 1024px) {
			.prof-row {
				flex-direction: column;
			}

			.prof-col-left {
				width: 100%;
			}
		}

		@@media (max-width: 480px) {
			.prof-form-row {
				grid-template-columns: 1fr;
			}

			.prof-page-header {
				padding: 20px;
			}

			.prof-form-body {
				padding: 16px;
			}
		}
	</style>
}

<div class="admin-page">
	<!-- HEADER -->
	<div class="admin-page-header">
		<div class="admin-page-header__icon"><i class="fa fa-shield"></i></div>
		<div class="admin-page-header__text">
			<h4>Thông tin cá nhân</h4>
			<p>Quản lý hồ sơ và thông tin tài khoản của bạn</p>
		</div>
	</div>

	<div class="admin-row">
		<!-- LEFT: PROFILE CARD -->
		<div class="admin-col-left">
			<div class="admin-card">
				<div class="admin-avatar-ring">
					@if (!string.IsNullOrEmpty(Model.AnhDaiDien))
					{
						<img src="@Model.AnhDaiDien" alt="@Model.HoTen">
					}
					else
					{
						<div class="admin-avatar-initials">
							@(Model.HoTen?.Split(' ').LastOrDefault()?[0].ToString()?.ToUpper() ?? "?")
						</div>
					}
				</div>

				<h5 class="admin-name">@Model.HoTen</h5>
				<p class="admin-email">@Model.Email</p>

				<div class="admin-meta">
					<i class="fa fa-crown" style="color: #7c3aed;"></i>
					<span>@(Model.ChucVu?.TenChucVu ?? "Chưa gán")</span>
				</div>

				<span class="admin-status">
					<i class="fa fa-circle-check"></i>Tích cực
				</span>

				<div class="admin-info-items">
					<div class="admin-info-item">
						<div class="admin-info-item__icon"><i class="fa fa-envelope"></i></div>
						<div style="flex: 1;">
							<div class="admin-info-item__label">Email</div>
							<div class="admin-info-item__value">@Model.Email</div>
						</div>
					</div>

					@if (!string.IsNullOrEmpty(Model.SoDienThoai))
					{
						<div class="admin-info-item">
							<div class="admin-info-item__icon"><i class="fa fa-phone"></i></div>
							<div style="flex: 1;">
								<div class="admin-info-item__label">Điện thoại</div>
								<div class="admin-info-item__value">@Model.SoDienThoai</div>
							</div>
						</div>
					}

					@if (!string.IsNullOrEmpty(Model.MaNV))
					{
						<div class="admin-info-item">
							<div class="admin-info-item__icon"><i class="fa fa-id-card"></i></div>
							<div style="flex: 1;">
								<div class="admin-info-item__label">Mã nhân viên</div>
								<div class="admin-info-item__value">@Model.MaNV</div>
							</div>
						</div>
					}
				</div>

				<hr class="my-3" style="border-color: var(--admin-border);" />
				<form method="post" asp-action="GuiOtpDoiMatKhau">
					@Html.AntiForgeryToken()
					<button type="submit" class="btn btn-outline-primary w-100 btn-sm">
						<i class="fa fa-key me-1"></i>
						Đổi mật khẩu
					</button>
				</form>
			</div>
		</div>

		<!-- RIGHT: FORM CARD -->
		<div class="admin-col-right">
			<div class="admin-form-card">
				<div class="admin-form-card__header">
					<div class="admin-form-card__header-icon"><i class="fa fa-pen-to-square"></i></div>
					<div>
						<div class="admin-form-card__header-text">Chỉnh sửa thông tin</div>
						<div class="admin-form-card__header-sub">Cập nhật hồ sơ của bạn</div>
					</div>
				</div>
				<div class="admin-form-body">
					<!-- OTP NOTICE -->
					<div class="admin-otp-notice">
						<div class="admin-otp-notice__icon"><i class="fa fa-shield-halved"></i></div>
						<div class="admin-otp-notice__text">
							Sau khi nhấn lưu, <strong>mã OTP</strong> sẽ được gửi về hộp thư email của bạn để xác nhận thay đổi.
						</div>
					</div>

					@if (ViewBag.Error != null)
					{
						<div class="alert alert-danger small py-2 mb-3">
							<i class="fa fa-circle-exclamation me-1"></i>@ViewBag.Error
						</div>
					}

					<form method="post" asp-action="EditProfile" enctype="multipart/form-data">
						@Html.AntiForgeryToken()

						<div class="admin-form-group">
							<label class="admin-label">Họ tên <span style="color: #dc2626;">*</span></label>
							<input type="text" name="HoTen" value="@Model.HoTen" class="admin-input" required placeholder="Nhập họ và tên đầy đủ" />
						</div>

						<div class="admin-form-group">
							<label class="admin-label">
								Email hiện tại
								<span style="color: #7c3aed; font-weight: 400; font-size: 11px; margin-left: 6px;">
									(để trống nếu không muốn đổi)
								</span>
							</label>
							<div style="position: relative;">
								<input type="text" class="admin-input" value="@Model.Email" disabled
									   style="background: #f0edff; color: #6b7280; cursor: not-allowed;" />
							</div>
						</div>

						<div class="admin-form-group">
							<label class="admin-label">
								Địa chỉ email mới
								<span style="color: #9ca3af; font-weight: 400; font-size: 11px; margin-left: 4px;">
									(không bắt buộc)
								</span>
							</label>
							<input type="email" name="NewEmail" class="admin-input" placeholder="Nhập email mới để đổi..." />
						</div>

						<div class="admin-form-row">
							<div class="admin-form-group">
								<label class="admin-label">Số điện thoại</label>
								<input type="text" name="SoDienThoai" value="@Model.SoDienThoai" class="admin-input" placeholder="0xxx xxx xxx" />
							</div>
							<div class="admin-form-group">
								<label class="admin-label">Địa chỉ</label>
								<input type="text" name="DiaChi" value="@Model.DiaChi" class="admin-input" placeholder="Địa chỉ của bạn" />
							</div>
						</div>

						<div class="admin-form-group">
							<label class="admin-label">Ảnh đại diện mới</label>
							<label class="admin-file-input" for="avatarFile">
								<i class="fa fa-cloud-arrow-up fa-lg mb-2 d-block" style="font-size: 24px;"></i>
								<div style="font-weight: 700;">Chọn ảnh từ máy tính</div>
								<div style="font-size: 11px; color: #9ca3af; margin-top: 4px;">PNG, JPG, GIF tối đa 5MB</div>
								<input type="file" id="avatarFile" name="AnhDaiDienFile" accept="image/*" class="d-none" />
							</label>
						</div>

						<button type="submit" class="admin-submit-btn">
							<i class="fa fa-paper-plane"></i>
							Gửi OTP để xác nhận thay đổi
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// Show filename when file selected
		document.getElementById('avatarFile').addEventListener('change', function() {
			const label = this.closest('label');
			if (this.files && this.files[0]) {
				const name = this.files[0].name;
				label.querySelector('div:nth-child(2)').textContent = '✅ ' + name;
			}
		});
	</script>
}
